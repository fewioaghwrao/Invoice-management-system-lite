<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>InvoiceAvaloniaClient</RootNamespace>
    <OutputType>WinExe</OutputType>
    <!--If you are willing to use platform-specific APIs, use conditional compilation.
    See https://docs.avaloniaui.net/docs/guides/platforms/platform-specific-code/dotnet for more details.-->
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <PropertyGroup>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>..\InvoiceAvaloniaClient\Assets\favicon.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <!-- API の接続先（WPF 版と同じ形式）。実行フォルダにコピーして読み込む -->
    <Content Include="appsettings.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia.Desktop" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\InvoiceAvaloniaClient\InvoiceAvaloniaClient.csproj" />
  </ItemGroup>
</Project>
