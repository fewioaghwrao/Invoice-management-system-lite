<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <!-- xUnit v3 のテストプロジェクトは実行ファイルとしてビルドする -->
    <OutputType>Exe</OutputType>
    <RootNamespace>InvoiceAvaloniaClient.Tests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- バージョンは ../Directory.Packages.props で一括管理 -->
    <PackageReference Include="Avalonia.Headless.XUnit" />
    <PackageReference Include="coverlet.collector" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="xunit.runner.visualstudio" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\InvoiceAvaloniaClient\InvoiceAvaloniaClient.csproj" />
  </ItemGroup>

</Project>
