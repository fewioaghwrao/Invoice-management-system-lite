<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignWidth="600"
             x:Class="InvoiceAvaloniaClient.Views.ForgotPasswordView"
             x:CompileBindings="False">

    <!-- Next.js frontend/src/app/auth/forgot-password/page.tsx に合わせたレイアウト。LoginWindow 内に差し込んで表示する。 -->
    <!-- カード: max-w-md rounded-3xl border-slate-800 bg-slate-900/80 p-6 shadow-xl -->
    <Border MaxWidth="448"
            CornerRadius="24"
            Background="{DynamicResource CardBrush}"
            BorderBrush="{DynamicResource Slate800Brush}"
            BorderThickness="1"
            BoxShadow="0 14 40 0 #59000000"
            Padding="24">
        <StackPanel>
            <Button Content="← ログインに戻る"
                    Margin="-4,0,0,16"
                    Classes="BackLinkButton"
                    Click="BackButton_OnClick"/>

            <TextBlock Text="パスワード再設定"
                       Foreground="{DynamicResource Slate50Brush}"
                       FontSize="20"
                       FontWeight="SemiBold"/>

            <TextBlock Text="登録したメールアドレス宛に再設定リンクを送信します。"
                       Margin="0,4,0,0"
                       FontSize="12"
                       Foreground="{DynamicResource Slate300Brush}"
                       TextWrapping="Wrap"/>

            <!-- 入力フォーム（送信後は非表示） -->
            <StackPanel x:Name="FormPanel" Margin="0,24,0,0">
                <TextBlock Text="メールアドレス" Classes="FieldLabel"/>
                <TextBox x:Name="EmailTextBox"
                         Classes="ModernTextBox"
                         PlaceholderText="example@example.com"/>

                <Border x:Name="ErrorBorder"
                        Margin="0,16,0,0"
                        Classes="ErrorBanner"
                        IsVisible="False">
                    <TextBlock x:Name="ErrorTextBlock" Classes="ErrorBannerText"/>
                </Border>

                <!-- 送信（Enter キーでも実行） -->
                <Button x:Name="SendButton"
                        Margin="0,16,0,0"
                        IsDefault="True"
                        Content="再設定メールを送信"
                        Classes="PrimaryButton"
                        Click="SendButton_OnClick"/>

                <TextBlock Text="メール送信後、ブラウザの再設定画面から新しいパスワードを登録します。"
                           Margin="0,12,0,0"
                           Classes="FieldHint"
                           FontSize="11"
                           HorizontalAlignment="Center"
                           TextAlignment="Center"/>
            </StackPanel>

            <!-- 送信完了（mt-6 text-sky-300 text-sm） -->
            <StackPanel x:Name="SentPanel" Margin="0,24,0,0" IsVisible="False">
                <TextBlock FontSize="14"
                           LineHeight="22"
                           Foreground="{DynamicResource Sky300Brush}"
                           TextWrapping="Wrap">
                    <Run Text="再設定リンクをメールに送信しました。"/>
                    <LineBreak/>
                    <Run Text="メールをご確認ください。"/>
                </TextBlock>

                <Button x:Name="BackToLoginButton"
                        Margin="0,24,0,0"
                        Content="ログイン画面に戻る"
                        Classes="SecondaryButton"
                        Click="BackButton_OnClick"/>
            </StackPanel>
        </StackPanel>
    </Border>
</UserControl>
