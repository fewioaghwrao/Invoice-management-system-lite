<UserControl x:Class="InvoiceAvaloniaClient.Views.AdminMemberListView"
             x:CompileBindings="False"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:helpers="using:InvoiceAvaloniaClient.Helpers"
             mc:Ignorable="d"
             d:DesignWidth="1150">

    <!-- 会員一覧（Next.js: app/members/page.tsx）。DataContext は MemberListViewModel。 -->

    <UserControl.Styles>
        <Style Selector="TextBlock.ListHeaderText">
            <Setter Property="Margin" Value="16,0"/>
        </Style>
        <Style Selector="TextBlock.ListCell">
            <Setter Property="Margin" Value="16,0"/>
        </Style>
    </UserControl.Styles>

    <StackPanel>
        <!-- ===== ページ見出し ===== -->
        <Border Classes="PageHeaderCard">
            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <Button Content="ダッシュボード" Classes="BreadcrumbButton" Click="BreadcrumbDashboard_OnClick"/>
                    <TextBlock Text=" / 会員一覧" Classes="BreadcrumbText"/>
                </StackPanel>
                <TextBlock Text="会員一覧" Margin="0,6,0,0" Classes="PageHeaderTitle"/>
                <TextBlock Text="会員の基本情報・ロール・有効状態を検索し、詳細を確認できます。" Margin="0,6,0,0" Classes="SmallMuted"/>
            </StackPanel>
        </Border>

        <!-- ===== 検索条件 ===== -->
        <Border Margin="0,24,0,0" Classes="PageHeaderCard">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="キーワード（名前 / メール）" Classes="AdminFieldLabel"/>
                        <TextBox Classes="AdminTextBox"
                                 PlaceholderText="例：山田 / example@example.com"
                                 Text="{Binding Keyword}">
                            <TextBox.KeyBindings>
                                <KeyBinding Gesture="Enter" Command="{Binding SearchCommand}"/>
                            </TextBox.KeyBindings>
                        </TextBox>
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <TextBlock Text="ロール" Classes="AdminFieldLabel"/>
                        <ComboBox Classes="AdminComboBox"
                                  ItemsSource="{Binding RoleOptions}"
                                  SelectedItem="{Binding SelectedRole, Converter={x:Static helpers:IgnoreNullConverter.Instance}}"
                                  DisplayMemberBinding="{Binding Label}"/>
                    </StackPanel>

                    <StackPanel Grid.Column="4">
                        <TextBlock Text="ステータス" Classes="AdminFieldLabel"/>
                        <ComboBox Classes="AdminComboBox"
                                  ItemsSource="{Binding StatusOptions}"
                                  SelectedItem="{Binding SelectedStatus, Converter={x:Static helpers:IgnoreNullConverter.Instance}}"
                                  DisplayMemberBinding="{Binding Label}"/>
                    </StackPanel>

                    <Button Grid.Column="6" VerticalAlignment="Bottom" Content="検索" Classes="EmeraldSolidButton" Command="{Binding SearchCommand}"/>
                    <Button Grid.Column="8" VerticalAlignment="Bottom" Content="リセット" MinHeight="34" Classes="AdminOutlineButton" Command="{Binding ResetCommand}"/>
                </Grid>

                <Border Margin="0,16,0,0"
                        Classes="RoseBanner"
                        IsVisible="{Binding HasError}">
                    <TextBlock Text="{Binding ErrorMessage}" Classes="RoseBannerText"/>
                </Border>
            </StackPanel>
        </Border>

        <!-- ===== 一覧 ===== -->
        <Border Margin="0,24,0,0" Classes="PageHeaderCard" Padding="0" ClipToBounds="True">
            <StackPanel>
                <Border Background="{DynamicResource Slate950_40Brush}" CornerRadius="16,16,0,0" Padding="0,12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="70"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="1.6*"/>
                            <ColumnDefinition Width="140"/>
                            <ColumnDefinition Width="110"/>
                            <ColumnDefinition Width="160"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="ID" Classes="InnerTableHeaderText ListHeaderText"/>
                        <TextBlock Grid.Column="1" Text="名前" Classes="InnerTableHeaderText ListHeaderText"/>
                        <TextBlock Grid.Column="2" Text="メールアドレス" Classes="InnerTableHeaderText ListHeaderText"/>
                        <TextBlock Grid.Column="3" Text="ロール" Classes="InnerTableHeaderText ListHeaderText"/>
                        <TextBlock Grid.Column="4" Text="状態" Classes="InnerTableHeaderText ListHeaderText"/>
                        <StackPanel Grid.Column="5" Orientation="Horizontal" HorizontalAlignment="Right">
                            <TextBlock Text="読み込み中..."
                                       Margin="0,0,12,0"
                                       FontSize="11"
                                       Foreground="{DynamicResource Sky300Brush}"
                                       IsVisible="{Binding IsLoading}"/>
                            <TextBlock Text="操作" Classes="InnerTableHeaderText ListHeaderText"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <ItemsControl ItemsSource="{Binding Members}" Focusable="False">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Classes="InnerTableRow" Padding="0,10" MinHeight="54">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="70"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="1.6*"/>
                                        <ColumnDefinition Width="140"/>
                                        <ColumnDefinition Width="110"/>
                                        <ColumnDefinition Width="160"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Column="0" Text="{Binding Id}" Classes="InnerTableCell ListCell"/>
                                    <TextBlock Grid.Column="1" Text="{Binding Name}" FontWeight="SemiBold" Foreground="{DynamicResource Slate50Brush}" TextTrimming="CharacterEllipsis" Classes="InnerTableCell ListCell"/>
                                    <TextBlock Grid.Column="2" Text="{Binding Email}" TextTrimming="CharacterEllipsis" Classes="InnerTableCell ListCell"/>

                                    <Border Grid.Column="3" Margin="16,0,0,0" Tag="{Binding Role, Converter={x:Static helpers:MemberRoleColorConverter.Instance}}" Classes="ColorPill">
                                        <TextBlock Text="{Binding RoleText}" FontSize="11" FontWeight="SemiBold"/>
                                    </Border>
                                    <Border Grid.Column="4" Margin="16,0,0,0" Tag="{Binding IsActive, Converter={x:Static helpers:ActiveColorConverter.Instance}}" Classes="ColorPill">
                                        <TextBlock Text="{Binding StatusText}" FontSize="11" FontWeight="SemiBold"/>
                                    </Border>

                                    <StackPanel Grid.Column="5" Margin="16,0" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                        <Button Content="詳細"
                                                Classes="AdminOutlineButton"
                                                Command="{Binding $parent[ItemsControl].DataContext.OpenDetailCommand}"
                                                CommandParameter="{Binding}"/>
                                        <Button Content="退会"
                                                Margin="8,0,0,0"
                                                IsVisible="{Binding CanDisable}"
                                                Classes="RoseOutlineButton"
                                                Command="{Binding $parent[ItemsControl].DataContext.DisableMemberCommand}"
                                                CommandParameter="{Binding}"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBlock Text="該当する会員はいません。"
                           Classes="InnerTableEmpty"
                           IsVisible="{Binding Members.Count, Converter={x:Static helpers:IntEqualsConverter.Instance}, ConverterParameter=0}"/>
            </StackPanel>
        </Border>

        <!-- ===== ページ送り ===== -->
        <Grid Margin="0,16,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="{Binding PageInfoText}" VerticalAlignment="Center" FontSize="12" FontWeight="Medium" Foreground="{DynamicResource Slate300Brush}"/>
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button Content="← 前へ" MinWidth="72" Classes="AdminOutlineButton" Command="{Binding PrevPageCommand}"/>
                <Button Content="次へ →" Margin="8,0,0,0" MinWidth="72" Classes="AdminOutlineButton" Command="{Binding NextPageCommand}"/>
            </StackPanel>
        </Grid>
    </StackPanel>
</UserControl>
