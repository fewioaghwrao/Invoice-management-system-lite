<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="InvoiceAvaloniaClient.Views.ConfirmDialogWindow"
        x:CompileBindings="False"
        Title="確認"
        Width="500"
        SizeToContent="Height"
        CanResize="False"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Background="#0F172A">

    <!-- 確認ダイアログ / お知らせダイアログ（WPF 版の ConfirmDialogWindow と MessageBox の置き換え） -->
    <Border Margin="0" Padding="26" Background="#EE0F172A">
        <Grid RowDefinitions="Auto,14,Auto,20,Auto">

            <!-- ヘッダ -->
            <StackPanel Grid.Row="0">
                <Border HorizontalAlignment="Left"
                        Background="#1E293B"
                        CornerRadius="999"
                        Padding="10,4">
                    <TextBlock Text="Invoice System"
                               Foreground="#7DD3FC"
                               FontSize="12"
                               FontWeight="SemiBold"/>
                </Border>

                <TextBlock x:Name="TitleText"
                           Margin="0,16,0,0"
                           Text="確認"
                           Foreground="White"
                           FontSize="24"
                           FontWeight="SemiBold"
                           TextWrapping="Wrap"/>
            </StackPanel>

            <!-- 本文 -->
            <Border Grid.Row="2"
                    CornerRadius="18"
                    Padding="18"
                    Background="#0B1220"
                    BorderBrush="#233044"
                    BorderThickness="1">
                <StackPanel Spacing="12">
                    <Border x:Name="IconBadge"
                            Width="52"
                            Height="52"
                            CornerRadius="26"
                            Background="#132032"
                            BorderBrush="#155E75"
                            BorderThickness="1"
                            HorizontalAlignment="Left">
                        <TextBlock x:Name="IconText"
                                   Text="?"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   Foreground="#7DD3FC"
                                   FontSize="22"
                                   FontWeight="SemiBold"/>
                    </Border>

                    <TextBlock x:Name="MessageText"
                               Margin="0,2,0,0"
                               Text="実行してもよろしいですか？"
                               Foreground="#E2E8F0"
                               FontSize="14"
                               FontWeight="SemiBold"
                               TextWrapping="Wrap"/>

                    <TextBlock x:Name="SubMessageText"
                               Foreground="#94A3B8"
                               FontSize="12"
                               TextWrapping="Wrap"
                               IsVisible="False"/>
                </StackPanel>
            </Border>

            <!-- ボタン -->
            <Grid Grid.Row="4" ColumnDefinitions="*,12,140,12,140">
                <Button x:Name="CancelButton"
                        Grid.Column="2"
                        Classes="DialogButton"
                        Content="キャンセル"
                        Background="#1E293B"
                        Foreground="#E2E8F0"
                        BorderBrush="#475569"
                        Click="CancelButton_OnClick"/>

                <Button x:Name="ConfirmButton"
                        Grid.Column="4"
                        Classes="DialogButton"
                        Content="OK"
                        Background="#0EA5E9"
                        Foreground="White"
                        BorderBrush="#0EA5E9"
                        Click="ConfirmButton_OnClick"/>
            </Grid>
        </Grid>
    </Border>
</Window>
