<Window x:Class="InvoiceSystem.Wpf.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="ログイン - Invoice Management System"
        Width="960"
        Height="720"
        MinWidth="520"
        MinHeight="560"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResize"
        Background="#020617"
        FontFamily="Segoe UI, Yu Gothic UI, Meiryo UI"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display"
        PreviewKeyDown="Window_OnPreviewKeyDown"
        FocusManager.FocusedElement="{Binding ElementName=EmailTextBox}">

    <!--
        ログイン前の画面をまとめたウィンドウ。
        ログイン / 新規会員登録 / パスワード再設定 を別ウィンドウにせず、このウィンドウ内で切り替える。
        スタイルは Themes/AuthTheme.xaml（App.xaml で読み込み）。
    -->
    <Grid>
        <!-- 背景: bg-slate-950 + radial(top, sky-500) + radial(bottom, indigo-500), opacity-70 -->
        <Grid IsHitTestVisible="False" Opacity="0.7">
            <Rectangle>
                <Rectangle.Fill>
                    <RadialGradientBrush Center="0.5,0" GradientOrigin="0.5,0" RadiusX="0.6" RadiusY="0.75">
                        <GradientStop Color="#0EA5E9" Offset="0"/>
                        <GradientStop Color="#000EA5E9" Offset="1"/>
                    </RadialGradientBrush>
                </Rectangle.Fill>
            </Rectangle>
            <Rectangle>
                <Rectangle.Fill>
                    <RadialGradientBrush Center="0.5,1" GradientOrigin="0.5,1" RadiusX="0.6" RadiusY="0.75">
                        <GradientStop Color="#6366F1" Offset="0"/>
                        <GradientStop Color="#006366F1" Offset="1"/>
                    </RadialGradientBrush>
                </Rectangle.Fill>
            </Rectangle>
        </Grid>

        <ScrollViewer x:Name="PageScrollViewer"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="16,32" VerticalAlignment="Center">

                <!-- ===== ログイン ===== -->
                <!-- 外側カード: max-w-3xl rounded-3xl border-slate-800 bg-slate-900/80 p-8 shadow-2xl -->
                <Grid x:Name="LoginPage" MaxWidth="768">
                    <Border CornerRadius="24" Background="{StaticResource CardBrush}">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="50" ShadowDepth="20" Direction="270" Opacity="0.35" Color="#000000"/>
                        </Border.Effect>
                    </Border>

                    <Border CornerRadius="24"
                            BorderBrush="{StaticResource Slate800Brush}"
                            BorderThickness="1"
                            Padding="32">
                        <StackPanel>
                            <Border Style="{StaticResource BrandPill}">
                                <TextBlock Text="Invoice Management System" Style="{StaticResource BrandPillText}"/>
                            </Border>

                            <TextBlock Text="ログイン" Margin="0,16,0,0" Style="{StaticResource PageTitle}"/>

                            <TextBlock Text="請求・入金情報を確認するため、ログインしてください。"
                                       Margin="0,8,0,0"
                                       Style="{StaticResource PageDescription}"/>

                            <!-- 内側カード: rounded-2xl bg-slate-900/80 p-6 shadow-lg（ヘッダーとの間は gap-10） -->
                            <Grid Margin="0,40,0,0">
                                <Border CornerRadius="16" Background="{StaticResource CardBrush}">
                                    <Border.Effect>
                                        <DropShadowEffect BlurRadius="18" ShadowDepth="6" Direction="270" Opacity="0.3" Color="#000000"/>
                                    </Border.Effect>
                                </Border>

                                <StackPanel Margin="24">

                                    <!-- 新規登録完了などのお知らせ（コードビハインドで表示） -->
                                    <Border x:Name="NoticeBorder"
                                            Margin="0,0,0,16"
                                            Style="{StaticResource SuccessBanner}"
                                            Visibility="Collapsed">
                                        <TextBlock x:Name="NoticeTextBlock" Style="{StaticResource SuccessBannerText}"/>
                                    </Border>

                                    <!-- メールアドレス -->
                                    <TextBlock Text="メールアドレス" Style="{StaticResource FieldLabel}"/>
                                    <TextBox x:Name="EmailTextBox"
                                             Style="{StaticResource ModernTextBox}"
                                             Tag="example@example.com"
                                             Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}"/>

                                    <!-- パスワード（入力欄の右端に表示/非表示ボタン） -->
                                    <TextBlock Text="パスワード" Margin="0,16,0,4" Style="{StaticResource FieldLabel}"/>
                                    <Grid>
                                        <PasswordBox x:Name="PasswordBox"
                                                     Style="{StaticResource ModernPasswordBox}"
                                                     Padding="12,0,72,0"
                                                     PasswordChanged="PasswordBox_OnPasswordChanged"/>

                                        <TextBox x:Name="VisiblePasswordTextBox"
                                                 Style="{StaticResource ModernTextBox}"
                                                 Padding="12,0,72,0"
                                                 Visibility="Collapsed"
                                                 TextChanged="VisiblePasswordTextBox_OnTextChanged"/>

                                        <TextBlock x:Name="PasswordPlaceholder"
                                                   Text="••••••••"
                                                   Margin="15,0,0,0"
                                                   VerticalAlignment="Center"
                                                   FontSize="14"
                                                   Foreground="{StaticResource PlaceholderBrush}"
                                                   IsHitTestVisible="False"/>

                                        <Button x:Name="TogglePasswordButton"
                                                Style="{StaticResource GhostButton}"
                                                Content="表示"
                                                HorizontalAlignment="Right"
                                                Margin="0,5,8,5"
                                                IsTabStop="False"
                                                Click="TogglePasswordButton_OnClick"/>
                                    </Grid>

                                    <!-- エラー -->
                                    <Border Margin="0,16,0,0"
                                            Style="{StaticResource ErrorBanner}"
                                            Visibility="{Binding HasError, Converter={StaticResource BooleanToVisibilityConverter}}">
                                        <TextBlock Text="{Binding ErrorMessage}" Style="{StaticResource ErrorBannerText}"/>
                                    </Border>

                                    <!-- ログイン（Enter キーでも実行） -->
                                    <Button Margin="0,20,0,0"
                                            IsDefault="True"
                                            Command="{Binding LoginCommand}">
                                        <Button.Style>
                                            <Style TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
                                                <Setter Property="Content" Value="ログイン"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsBusy}" Value="True">
                                                        <Setter Property="Content" Value="ログイン中..."/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>

                                    <!-- 新規会員登録 -->
                                    <TextBlock Text="初めてご利用の方はこちら"
                                               Margin="0,16,0,8"
                                               HorizontalAlignment="Center"
                                               FontSize="12"
                                               Foreground="{StaticResource Slate300Brush}"/>

                                    <Button Content="新規会員登録"
                                            Style="{StaticResource SecondaryButton}"
                                            Click="RegisterButton_OnClick"/>

                                    <!-- パスワード再設定 -->
                                    <Button Content="パスワードをお忘れの方はこちら"
                                            Margin="0,12,0,0"
                                            Style="{StaticResource LinkButton}"
                                            Click="ForgotPasswordButton_OnClick"/>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- ===== 新規会員登録 / パスワード再設定（コードビハインドで差し込む） ===== -->
                <ContentControl x:Name="SubPageHost"
                                Focusable="False"
                                Visibility="Collapsed"/>

                <!-- 利用規約 / プライバシーポリシー（全画面共通・ブラウザで開く） -->
                <StackPanel Margin="0,16,0,0"
                            Orientation="Horizontal"
                            HorizontalAlignment="Center">
                    <Button Content="利用規約"
                            Style="{StaticResource FooterLinkButton}"
                            Click="OpenTermsButton_OnClick"/>
                    <TextBlock Text="·"
                               Margin="4,0"
                               VerticalAlignment="Center"
                               FontSize="11"
                               Foreground="{StaticResource Slate400Brush}"/>
                    <Button Content="プライバシーポリシー"
                            Style="{StaticResource FooterLinkButton}"
                            Click="OpenPrivacyPolicyButton_OnClick"/>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
