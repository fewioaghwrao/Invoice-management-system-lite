<UserControl x:Class="InvoiceSystem.Wpf.Views.AdminPaymentDetailView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:helpers="clr-namespace:InvoiceSystem.Wpf.Helpers"
             mc:Ignorable="d"
             d:DesignWidth="1150">

    <!-- 入金詳細（割当）（Next.js: app/payments/[id]/PaymentDetailClient.tsx）。DataContext は PaymentDetailViewModel。 -->
    <UserControl.Resources>
        <helpers:UpperCaseConverter x:Key="UpperCase"/>

        <Style x:Key="SectionTitle2" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource Slate100Brush}"/>
        </Style>
        <Style x:Key="InfoValue" TargetType="TextBlock">
            <Setter Property="Margin" Value="0,6,0,0"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource Slate100Brush}"/>
        </Style>
    </UserControl.Resources>

    <StackPanel>
        <!-- ===== ページ見出し ===== -->
        <Border Style="{StaticResource PageHeaderCard}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <Button Content="ダッシュボード" Style="{StaticResource BreadcrumbButton}" Click="BreadcrumbDashboard_OnClick"/>
                        <TextBlock Text=" / " Style="{StaticResource BreadcrumbText}"/>
                        <Button Content="入金一覧" Style="{StaticResource BreadcrumbButton}" Click="BackToListButton_OnClick"/>
                        <TextBlock Text=" / 入金詳細" Style="{StaticResource BreadcrumbText}"/>
                    </StackPanel>
                    <StackPanel Margin="0,6,0,0" Orientation="Horizontal">
                        <TextBlock Text="入金詳細（割当）" Style="{StaticResource PageHeaderTitle}"/>
                        <TextBlock Margin="12,0,0,0"
                                   Text="読み込み中..."
                                   VerticalAlignment="Center"
                                   FontSize="12"
                                   Foreground="{StaticResource Sky300Brush}"
                                   Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                    </StackPanel>
                    <TextBlock Text="入金状況を確認し、請求書への割当を管理します。" Margin="0,6,0,0" Style="{StaticResource SmallMuted}"/>
                </StackPanel>
                <Button Grid.Column="1"
                        Content="← 入金一覧へ"
                        VerticalAlignment="Center"
                        Style="{StaticResource AdminOutlineButton}"
                        Click="BackToListButton_OnClick"/>
            </Grid>
        </Border>

        <Border Margin="0,16,0,0"
                Style="{StaticResource RoseBanner}"
                Visibility="{Binding HasError, Converter={StaticResource BooleanToVisibilityConverter}}">
            <TextBlock Text="{Binding ErrorMessage}" Style="{StaticResource RoseBannerText}"/>
        </Border>

        <!-- ===== 入金の概要 ===== -->
        <Border Margin="0,24,0,0" Style="{StaticResource PageHeaderCard}">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="入金ID" FontSize="11" Foreground="{StaticResource Slate400Brush}"/>
                        <TextBlock Text="{Binding PaymentIdText}" Margin="0,4,0,0" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource Slate50Brush}"/>
                    </StackPanel>
                    <Border Grid.Column="1"
                            VerticalAlignment="Top"
                            Tag="{Binding Status, Converter={StaticResource UpperCase}}"
                            Style="{StaticResource AllocationStatusPill}">
                        <TextBlock Text="{Binding StatusText}" FontSize="11" FontWeight="SemiBold"/>
                    </Border>
                </Grid>

                <Grid Margin="0,16,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="12"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Grid.Column="0" Style="{StaticResource StatBox}">
                        <StackPanel>
                            <TextBlock Text="入金額" Style="{StaticResource StatLabel}"/>
                            <TextBlock Text="{Binding AmountText}" Style="{StaticResource StatValue}" Foreground="#6EE7B7"/>
                        </StackPanel>
                    </Border>
                    <Border Grid.Row="0" Grid.Column="2" Style="{StaticResource StatBox}">
                        <StackPanel>
                            <TextBlock Text="割当合計" Style="{StaticResource StatLabel}"/>
                            <TextBlock Text="{Binding AllocatedAmountText}" Style="{StaticResource StatValue}"/>
                            <TextBlock Margin="0,4,0,0" FontSize="11" Foreground="{StaticResource Slate400Brush}">
                                <Run Text="（入力中合計: "/><Run Text="{Binding InputAllocatedSumText, Mode=OneWay}"/><Run Text="）"/>
                            </TextBlock>
                        </StackPanel>
                    </Border>
                    <Border Grid.Row="0" Grid.Column="4" Style="{StaticResource StatBox}">
                        <StackPanel>
                            <TextBlock Text="未割当" Style="{StaticResource StatLabel}"/>
                            <TextBlock Text="{Binding UnallocatedAmountText}" Style="{StaticResource StatValue}" Foreground="{StaticResource Amber300Brush}"/>
                        </StackPanel>
                    </Border>

                    <Border Grid.Row="2" Grid.Column="0" Style="{StaticResource StatBox}">
                        <StackPanel>
                            <TextBlock Text="入金日" Style="{StaticResource StatLabel}"/>
                            <TextBlock Text="{Binding PaymentDateText}" Style="{StaticResource InfoValue}"/>
                        </StackPanel>
                    </Border>
                    <Border Grid.Row="2" Grid.Column="2" Grid.ColumnSpan="3" Style="{StaticResource StatBox}">
                        <StackPanel>
                            <TextBlock Text="入金名義" Style="{StaticResource StatLabel}"/>
                            <TextBlock Text="{Binding PayerName}" Style="{StaticResource InfoValue}"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </StackPanel>
        </Border>

        <!-- ===== 請求書への割当 ===== -->
        <Border Margin="0,24,0,0" Style="{StaticResource PageHeaderCard}">
            <StackPanel>
                <Grid Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="請求書への割当" Style="{StaticResource SectionTitle2}"/>
                        <TextBlock Text="請求書番号で検索して選択してください" Margin="0,4,0,0" FontSize="11" Foreground="{StaticResource Slate400Brush}"/>
                    </StackPanel>
                    <Button Grid.Column="1" Content="＋ 行を追加" VerticalAlignment="Center" Style="{StaticResource AdminOutlineButton}" Click="AddRowButton_OnClick"/>
                </Grid>

                <ItemsControl x:Name="AllocationItems" ItemsSource="{Binding AllocationRows}" Focusable="False">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Margin="0,0,0,12" Style="{StaticResource StatBox}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="3*"/>
                                        <ColumnDefinition Width="12"/>
                                        <ColumnDefinition Width="1.5*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- 請求書（検索して選択） -->
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="請求書（検索して選択）" Style="{StaticResource AdminFieldLabel}"/>
                                        <Grid>
                                            <TextBox x:Name="InvoiceSearchBox"
                                                     Padding="12,0,80,0"
                                                     Tag="請求書番号を入力して Enter または「検索」"
                                                     Text="{Binding InvoiceNumber, UpdateSourceTrigger=PropertyChanged}"
                                                     KeyDown="InvoiceSearchBox_OnKeyDown">
                                                <TextBox.Style>
                                                    <Style TargetType="TextBox" BasedOn="{StaticResource AdminTextBox}">
                                                        <Setter Property="IsReadOnly" Value="True"/>
                                                        <Style.Triggers>
                                                            <!-- 請求書を選択済みの行は読み取り専用（変更は「解除」してから） -->
                                                            <DataTrigger Binding="{Binding InvoiceId, TargetNullValue=0}" Value="0">
                                                                <Setter Property="IsReadOnly" Value="False"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBox.Style>
                                            </TextBox>

                                            <!-- 未選択: 検索 / 選択済み: 解除 -->
                                            <Button HorizontalAlignment="Right"
                                                    Margin="0,4,4,4"
                                                    MinHeight="24"
                                                    Padding="10,0"
                                                    Click="SearchOrClearButton_OnClick">
                                                <Button.Style>
                                                    <Style TargetType="Button" BasedOn="{StaticResource AdminOutlineButton}">
                                                        <Setter Property="Content" Value="解除"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding InvoiceId, TargetNullValue=0}" Value="0">
                                                                <Setter Property="Content" Value="検索"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Button.Style>
                                            </Button>
                                        </Grid>

                                        <TextBlock Margin="0,4,0,0" FontSize="11" Foreground="{StaticResource Slate500Brush}">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding InvoiceId, TargetNullValue=0}" Value="0">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                            <Run Text="選択中: "/><Run Text="{Binding InvoiceNumber, Mode=OneWay}" FontWeight="SemiBold" Foreground="{StaticResource Slate200Brush}"/><Run Text="（ID:"/><Run Text="{Binding InvoiceId, Mode=OneWay}"/><Run Text="）"/>
                                        </TextBlock>
                                    </StackPanel>

                                    <!-- 割当金額 -->
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="割当金額（円）" Style="{StaticResource AdminFieldLabel}"/>
                                        <TextBox Style="{StaticResource AdminTextBox}"
                                                 InputScope="Number"
                                                 Tag="例：60000"
                                                 Text="{Binding AmountText, UpdateSourceTrigger=PropertyChanged}"
                                                 TextChanged="AmountTextBox_OnTextChanged"/>
                                    </StackPanel>

                                    <Button Grid.Column="4"
                                            VerticalAlignment="Center"
                                            Content="削除"
                                            Style="{StaticResource AdminOutlineButton}"
                                            Click="RemoveRowButton_OnClick"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- 検索結果（候補） -->
                <Border Margin="0,0,0,12"
                        CornerRadius="12"
                        BorderThickness="1"
                        BorderBrush="#660EA5E9"
                        Background="#0D0EA5E9"
                        Padding="16,12">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding CandidateInvoices.Count}" Value="0">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <StackPanel>
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="CandidateTitleText"
                                       Text="検索結果（選択すると行に設定されます）"
                                       FontSize="12"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource Sky200Brush}"/>
                            <Button Grid.Column="1" Content="閉じる" Style="{StaticResource AdminOutlineButton}" Click="CloseCandidatesButton_OnClick"/>
                        </Grid>

                        <ItemsControl ItemsSource="{Binding CandidateInvoices}" Focusable="False">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource InnerTableRow}" Padding="0,8">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="2*"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="120"/>
                                                <ColumnDefinition Width="100"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{Binding InvoiceNumber}" FontWeight="SemiBold" Foreground="{StaticResource Slate100Brush}" Style="{StaticResource InnerTableCell}"/>
                                            <TextBlock Grid.Column="1" Text="{Binding MemberName}" TextTrimming="CharacterEllipsis" Style="{StaticResource InnerTableCell}"/>
                                            <TextBlock Grid.Column="2" Text="{Binding TotalAmount, StringFormat='￥{0:N0}'}" HorizontalAlignment="Right" Style="{StaticResource InnerTableCell}"/>
                                            <Border Grid.Column="3"
                                                    Margin="12,0,0,0"
                                                    Style="{StaticResource StatusPill}"
                                                    Background="{Binding StatusBackground}"
                                                    BorderBrush="{Binding StatusBorderBrush}">
                                                <TextBlock Text="{Binding StatusName}" FontSize="11" FontWeight="SemiBold" Foreground="{Binding StatusForeground}"/>
                                            </Border>
                                            <Button Grid.Column="4" Margin="12,0" Content="選択" Style="{StaticResource AdminOutlineButton}" Click="ApplyCandidateButton_OnClick"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Button Content="戻る" MinWidth="64" Style="{StaticResource AdminOutlineButton}" Click="BackToListButton_OnClick"/>
                    <Button Grid.Column="2" Click="SaveButton_OnClick">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource EmeraldSolidButton}">
                                <Setter Property="Content" Value="割当を保存"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsSaving}" Value="True">
                                        <Setter Property="Content" Value="保存中..."/>
                                        <Setter Property="IsEnabled" Value="False"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </Grid>
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
