<UserControl x:Class="InvoiceSystem.Wpf.Views.ForgotPasswordView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignWidth="600"
             Loaded="ForgotPasswordView_OnLoaded">

    <!-- Next.js frontend/src/app/auth/forgot-password/page.tsx に合わせたレイアウト。LoginWindow 内に差し込んで表示する。 -->

    <!-- カード: max-w-md rounded-3xl border-slate-800 bg-slate-900/80 p-6 shadow-xl -->
    <Grid MaxWidth="448">
        <Border CornerRadius="24" Background="{StaticResource CardBrush}">
            <Border.Effect>
                <DropShadowEffect BlurRadius="40" ShadowDepth="14" Direction="270" Opacity="0.35" Color="#000000"/>
            </Border.Effect>
        </Border>

        <Border CornerRadius="24"
                BorderBrush="{StaticResource Slate800Brush}"
                BorderThickness="1"
                Padding="24">
            <StackPanel>
                <Button Content="← ログインに戻る"
                        Margin="-4,0,0,16"
                        Style="{StaticResource BackLinkButton}"
                        Click="BackButton_OnClick"/>

                <TextBlock Text="パスワード再設定"
                           Foreground="{StaticResource Slate50Brush}"
                           FontSize="20"
                           FontWeight="SemiBold"/>

                <TextBlock Text="登録したメールアドレス宛に再設定リンクを送信します。"
                           Margin="0,4,0,0"
                           FontSize="12"
                           Foreground="{StaticResource Slate300Brush}"
                           TextWrapping="Wrap"/>

                <!-- 入力フォーム（送信後は非表示） -->
                <StackPanel x:Name="FormPanel" Margin="0,24,0,0">
                    <TextBlock Text="メールアドレス" Style="{StaticResource FieldLabel}"/>
                    <TextBox x:Name="EmailTextBox"
                             Style="{StaticResource ModernTextBox}"
                             Tag="example@example.com"/>

                    <Border x:Name="ErrorBorder"
                            Margin="0,16,0,0"
                            Style="{StaticResource ErrorBanner}"
                            Visibility="Collapsed">
                        <TextBlock x:Name="ErrorTextBlock" Style="{StaticResource ErrorBannerText}"/>
                    </Border>

                    <!-- 送信（Enter キーでも実行） -->
                    <Button x:Name="SendButton"
                            Margin="0,16,0,0"
                            IsDefault="True"
                            Content="再設定メールを送信"
                            Style="{StaticResource PrimaryButton}"
                            Click="SendButton_OnClick"/>

                    <TextBlock Text="メール送信後、ブラウザの再設定画面から新しいパスワードを登録します。"
                               Margin="0,12,0,0"
                               Style="{StaticResource FieldHint}"
                               FontSize="11"
                               HorizontalAlignment="Center"
                               TextAlignment="Center"/>
                </StackPanel>

                <!-- 送信完了（mt-6 text-sky-300 text-sm） -->
                <StackPanel x:Name="SentPanel" Margin="0,24,0,0" Visibility="Collapsed">
                    <TextBlock FontSize="14"
                               LineHeight="22"
                               Foreground="{StaticResource Sky300Brush}"
                               TextWrapping="Wrap">
                        再設定リンクをメールに送信しました。<LineBreak/>
                        メールをご確認ください。
                    </TextBlock>

                    <Button x:Name="BackToLoginButton"
                            Margin="0,24,0,0"
                            Content="ログイン画面に戻る"
                            Style="{StaticResource SecondaryButton}"
                            Click="BackButton_OnClick"/>
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
