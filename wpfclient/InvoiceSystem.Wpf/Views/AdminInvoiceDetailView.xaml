<UserControl x:Class="InvoiceSystem.Wpf.Views.AdminInvoiceDetailView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:helpers="clr-namespace:InvoiceSystem.Wpf.Helpers"
             mc:Ignorable="d"
             d:DesignWidth="1150">

    <!-- 請求書詳細（管理者）（Next.js: app/invoices/[id]/page.tsx）。DataContext は AdminInvoiceDetailViewModel。 -->
    <UserControl.Resources>
        <helpers:PaymentMethodLabelConverter x:Key="PaymentMethodLabel"/>

        <Style x:Key="SectionPanel" TargetType="Border" BasedOn="{StaticResource PageHeaderCard}"/>
        <Style x:Key="SectionTitle2" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource Slate100Brush}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="InfoLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="{StaticResource Slate400Brush}"/>
            <Setter Property="Margin" Value="0,12,0,2"/>
        </Style>
        <Style x:Key="InfoValue" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource Slate100Brush}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style x:Key="EmptyBox" TargetType="Border">
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="{StaticResource Slate800Brush}"/>
            <Setter Property="Background" Value="{StaticResource Slate950_40Brush}"/>
            <Setter Property="Padding" Value="16,20"/>
        </Style>
    </UserControl.Resources>

    <StackPanel>
        <!-- ===== ページ見出し ===== -->
        <Border Style="{StaticResource PageHeaderCard}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <Button Content="ダッシュボード" Style="{StaticResource BreadcrumbButton}" Click="BreadcrumbDashboard_OnClick"/>
                        <TextBlock Text=" / " Style="{StaticResource BreadcrumbText}"/>
                        <Button Content="請求書一覧" Style="{StaticResource BreadcrumbButton}" Click="BackToListButton_OnClick"/>
                        <TextBlock Text=" / " Style="{StaticResource BreadcrumbText}"/>
                        <TextBlock Text="{Binding InvoiceNumber}" Style="{StaticResource BreadcrumbText}"/>
                    </StackPanel>
                    <StackPanel Margin="0,6,0,0" Orientation="Horizontal">
                        <TextBlock Text="{Binding InvoiceNumber}" Style="{StaticResource PageHeaderTitle}"/>
                        <Border Margin="10,0,0,0"
                                Style="{StaticResource StatusPill}"
                                Background="{Binding StatusBackground}"
                                BorderBrush="{Binding StatusBorderBrush}">
                            <TextBlock Text="{Binding StatusName}" FontSize="11" FontWeight="SemiBold" Foreground="{Binding StatusForeground}"/>
                        </Border>
                        <TextBlock Margin="12,0,0,0"
                                   Text="読み込み中..."
                                   VerticalAlignment="Center"
                                   FontSize="12"
                                   Foreground="{StaticResource Sky300Brush}"
                                   Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                    </StackPanel>
                    <TextBlock Text="請求情報・入金割当・督促履歴・残額をまとめて確認できます。"
                               Margin="0,6,0,0"
                               Style="{StaticResource SmallMuted}"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="← 一覧へ" Style="{StaticResource AdminOutlineButton}" Click="BackToListButton_OnClick"/>
                    <Button Content="編集" Margin="8,0,0,0" Style="{StaticResource AdminOutlineButton}" Click="EditButton_OnClick"/>
                    <Button Content="督促へ" Margin="8,0,0,0" Style="{StaticResource AmberOutlineButton}" Click="CollectionButton_OnClick"/>
                    <Button Content="入金登録" Margin="8,0,0,0" Style="{StaticResource AdminOutlineButton}" Click="PaymentCreateButton_OnClick"/>
                </StackPanel>
            </Grid>
        </Border>

        <Border Margin="0,16,0,0"
                Style="{StaticResource RoseBanner}"
                Visibility="{Binding HasError, Converter={StaticResource BooleanToVisibilityConverter}}">
            <TextBlock Text="{Binding ErrorMessage}" Style="{StaticResource RoseBannerText}"/>
        </Border>

        <!-- ===== 金額 ===== -->
        <Border Margin="0,24,0,0" Style="{StaticResource SectionPanel}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Style="{StaticResource StatBox}">
                    <StackPanel>
                        <TextBlock Text="請求金額" Style="{StaticResource StatLabel}"/>
                        <TextBlock Text="{Binding TotalAmountText}" Style="{StaticResource StatValue}"/>
                    </StackPanel>
                </Border>
                <Border Grid.Column="2" Style="{StaticResource StatBox}">
                    <StackPanel>
                        <TextBlock Text="入金済み" Style="{StaticResource StatLabel}"/>
                        <TextBlock Text="{Binding PaidAmountText}" Style="{StaticResource StatValue}" Foreground="#6EE7B7"/>
                    </StackPanel>
                </Border>
                <Border Grid.Column="4" Style="{StaticResource StatBox}">
                    <StackPanel>
                        <TextBlock Text="残額" Style="{StaticResource StatLabel}"/>
                        <TextBlock Text="{Binding RemainingAmountText}" Style="{StaticResource StatValue}" Foreground="{StaticResource Amber300Brush}"/>
                        <TextBlock Margin="0,6,0,0" FontSize="11" Foreground="{StaticResource Slate400Brush}">
                            <Run Text="支払期限："/><Run Text="{Binding DueDate, StringFormat=yyyy-MM-dd, Mode=OneWay}"/>
                        </TextBlock>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- ===== 左: 基本情報・督促履歴 / 右: 請求明細・入金履歴 ===== -->
        <Grid Margin="0,24,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="24"/>
                <ColumnDefinition Width="2*"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <!-- 基本情報 -->
                <Border Style="{StaticResource SectionPanel}">
                    <StackPanel>
                        <TextBlock Text="基本情報" Style="{StaticResource SectionTitle2}"/>
                        <TextBlock Text="請求日" Style="{StaticResource InfoLabel}"/>
                        <TextBlock Text="{Binding InvoiceDate, StringFormat=yyyy-MM-dd}" Style="{StaticResource InfoValue}"/>
                        <TextBlock Text="支払期限" Style="{StaticResource InfoLabel}"/>
                        <TextBlock Text="{Binding DueDate, StringFormat=yyyy-MM-dd}" Style="{StaticResource InfoValue}"/>
                        <TextBlock Text="会員" Style="{StaticResource InfoLabel}"/>
                        <TextBlock Text="{Binding MemberName}" Style="{StaticResource InfoValue}"/>
                        <TextBlock Text="備考" Style="{StaticResource InfoLabel}"/>
                        <TextBlock Text="{Binding Remarks, TargetNullValue=—}" Style="{StaticResource InfoValue}"/>
                    </StackPanel>
                </Border>

                <!-- 督促履歴 -->
                <Border Margin="0,24,0,0" Style="{StaticResource SectionPanel}">
                    <StackPanel>
                        <TextBlock Text="督促履歴" Margin="0,0,0,12" Style="{StaticResource SectionTitle2}"/>

                        <ItemsControl ItemsSource="{Binding Reminders}" Focusable="False">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Margin="0,0,0,8" Style="{StaticResource StatBox}" Padding="12">
                                        <StackPanel>
                                            <TextBlock FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource Slate100Brush}">
                                                <Run Text="{Binding RemindedAt, StringFormat=yyyy-MM-dd HH:mm, Mode=OneWay}"/><Run Text=" / "/><Run Text="{Binding Method, Mode=OneWay}"/>
                                            </TextBlock>
                                            <TextBlock Text="{Binding Note, TargetNullValue=—}"
                                                       Margin="0,4,0,0"
                                                       FontSize="11"
                                                       Foreground="{StaticResource Slate400Brush}"
                                                       TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <Border>
                            <Border.Style>
                                <Style TargetType="Border" BasedOn="{StaticResource EmptyBox}">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Reminders.Count}" Value="0">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <TextBlock Text="督促履歴がありません。" HorizontalAlignment="Center" FontSize="12" Foreground="{StaticResource Slate400Brush}"/>
                        </Border>
                    </StackPanel>
                </Border>
            </StackPanel>

            <StackPanel Grid.Column="2">
                <!-- 請求明細 -->
                <Border Style="{StaticResource SectionPanel}">
                    <StackPanel>
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="請求明細" Style="{StaticResource SectionTitle2}"/>
                            <Button Grid.Column="1" Content="PDFダウンロード" Style="{StaticResource AdminOutlineButton}" Click="OpenPdfButton_OnClick"/>
                        </Grid>

                        <Border Style="{StaticResource InnerTable}">
                            <StackPanel>
                                <Border Style="{StaticResource InnerTableHeader}" Padding="0,8">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="2*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="項目" Style="{StaticResource InnerTableHeaderText}" Margin="16,0"/>
                                        <TextBlock Grid.Column="1" Text="数量" HorizontalAlignment="Right" Style="{StaticResource InnerTableHeaderText}" Margin="16,0"/>
                                        <TextBlock Grid.Column="2" Text="単価" HorizontalAlignment="Right" Style="{StaticResource InnerTableHeaderText}" Margin="16,0"/>
                                        <TextBlock Grid.Column="3" Text="金額" HorizontalAlignment="Right" Style="{StaticResource InnerTableHeaderText}" Margin="16,0"/>
                                    </Grid>
                                </Border>
                                <ItemsControl ItemsSource="{Binding Lines}" Focusable="False">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Style="{StaticResource InnerTableRow}" Padding="0,10">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="2*"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0" Text="{Binding Name}" FontWeight="SemiBold" Foreground="{StaticResource Slate100Brush}" Style="{StaticResource InnerTableCell}" Margin="16,0" TextTrimming="CharacterEllipsis"/>
                                                    <TextBlock Grid.Column="1" Text="{Binding Qty, StringFormat={}{0:#,0.##}}" HorizontalAlignment="Right" Style="{StaticResource InnerTableCell}" Margin="16,0"/>
                                                    <TextBlock Grid.Column="2" Text="{Binding UnitPrice, StringFormat='￥{0:N0}'}" HorizontalAlignment="Right" Style="{StaticResource InnerTableCell}" Margin="16,0"/>
                                                    <TextBlock Grid.Column="3" Text="{Binding Amount, StringFormat='￥{0:N0}'}" HorizontalAlignment="Right" FontWeight="SemiBold" Foreground="{StaticResource Slate100Brush}" Style="{StaticResource InnerTableCell}" Margin="16,0"/>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- 入金履歴（割当） -->
                <Border Margin="0,24,0,0" Style="{StaticResource SectionPanel}">
                    <StackPanel>
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="入金履歴（割当）" Style="{StaticResource SectionTitle2}"/>
                            <Button Grid.Column="1" Content="入金登録" Style="{StaticResource AdminOutlineButton}" Click="PaymentCreateButton_OnClick"/>
                        </Grid>

                        <ItemsControl ItemsSource="{Binding Allocations}" Focusable="False">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Margin="0,0,0,8" Style="{StaticResource StatBox}" Padding="16,12">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource Slate100Brush}">
                                                    <Run Text="{Binding PaymentDate, StringFormat=yyyy-MM-dd, Mode=OneWay}"/><Run Text=" / "/><Run Text="{Binding Method, Converter={StaticResource PaymentMethodLabel}, Mode=OneWay}"/>
                                                </TextBlock>
                                                <TextBlock Margin="0,4,0,0" FontSize="11" Foreground="{StaticResource Slate400Brush}">
                                                    <Run Text="名義："/><Run Text="{Binding PayerName, TargetNullValue=—, Mode=OneWay}"/>
                                                </TextBlock>
                                            </StackPanel>
                                            <TextBlock Grid.Column="1"
                                                       VerticalAlignment="Center"
                                                       Text="{Binding AllocatedAmount, StringFormat='￥{0:N0}'}"
                                                       FontSize="14"
                                                       FontWeight="SemiBold"
                                                       Foreground="#6EE7B7"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <Border>
                            <Border.Style>
                                <Style TargetType="Border" BasedOn="{StaticResource EmptyBox}">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Allocations.Count}" Value="0">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <TextBlock Text="入金の割当はまだありません。" HorizontalAlignment="Center" FontSize="12" Foreground="{StaticResource Slate400Brush}"/>
                        </Border>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>
    </StackPanel>
</UserControl>
