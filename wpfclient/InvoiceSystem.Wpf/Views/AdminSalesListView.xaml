<UserControl x:Class="InvoiceSystem.Wpf.Views.AdminSalesListView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:helpers="clr-namespace:InvoiceSystem.Wpf.Helpers"
             mc:Ignorable="d"
             d:DesignWidth="1150">

    <!-- 売上一覧（請求ベース）（Next.js: app/sales/page.tsx）。DataContext は SalesListViewModel。 -->
    <UserControl.Resources>
        <helpers:SalesStatusColorConverter x:Key="SalesStatusColor"/>

        <Style x:Key="ListHeaderText" TargetType="TextBlock" BasedOn="{StaticResource InnerTableHeaderText}">
            <Setter Property="Margin" Value="12,0"/>
        </Style>
        <Style x:Key="ListCell" TargetType="TextBlock" BasedOn="{StaticResource InnerTableCell}">
            <Setter Property="Margin" Value="12,0"/>
        </Style>
    </UserControl.Resources>

    <StackPanel>
        <!-- ===== ページ見出し ===== -->
        <Border Style="{StaticResource PageHeaderCard}">
            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <Button Content="ダッシュボード" Style="{StaticResource BreadcrumbButton}" Click="BreadcrumbDashboard_OnClick"/>
                    <TextBlock Text=" / 売上一覧" Style="{StaticResource BreadcrumbText}"/>
                </StackPanel>
                <TextBlock Text="売上一覧（請求ベース）" Margin="0,6,0,0" Style="{StaticResource PageHeaderTitle}"/>
                <TextBlock Text="請求金額を「売上」として一覧化し、入金済み・残額もあわせて確認できます。" Margin="0,6,0,0" Style="{StaticResource SmallMuted}"/>
            </StackPanel>
        </Border>

        <!-- ===== 検索条件 ===== -->
        <Border Margin="0,24,0,0" Style="{StaticResource PageHeaderCard}">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="年" Style="{StaticResource AdminFieldLabel}"/>
                        <ComboBox x:Name="YearComboBox"
                                  Style="{StaticResource AdminComboBox}"
                                  SelectedItem="{Binding SelectedYear}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding StringFormat={}{0}年}"/>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <TextBlock Text="月" Style="{StaticResource AdminFieldLabel}"/>
                        <ComboBox Style="{StaticResource AdminComboBox}"
                                  ItemsSource="{Binding MonthOptions}"
                                  SelectedItem="{Binding SelectedMonth}"
                                  DisplayMemberPath="Label"/>
                    </StackPanel>

                    <StackPanel Grid.Column="4">
                        <TextBlock Text="ステータス" Style="{StaticResource AdminFieldLabel}"/>
                        <ComboBox Style="{StaticResource AdminComboBox}"
                                  ItemsSource="{Binding StatusOptions}"
                                  SelectedItem="{Binding SelectedStatus}"
                                  DisplayMemberPath="Label"/>
                    </StackPanel>
                </Grid>

                <TextBlock Text="検索（請求書ID / 顧客名）" Margin="0,16,0,4" Style="{StaticResource AdminFieldLabel}"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox Style="{StaticResource AdminTextBox}"
                             Tag="例: INV-002 / クライアントA"
                             Text="{Binding Keyword, UpdateSourceTrigger=PropertyChanged}"
                             KeyDown="KeywordTextBox_OnKeyDown"/>
                    <Button Grid.Column="2" Content="検索" MinWidth="56" MinHeight="34" Style="{StaticResource AdminOutlineButton}" Click="SearchButton_OnClick"/>
                    <Button Grid.Column="4" Content="リセット" MinWidth="72" MinHeight="34" Style="{StaticResource AdminOutlineButton}" Click="ResetButton_OnClick"/>
                </Grid>

                <!-- 顧客で絞り込み中（ダッシュボード・顧客別集計から開いた場合） -->
                <Border Margin="0,12,0,0"
                        HorizontalAlignment="Left"
                        CornerRadius="999"
                        BorderThickness="1"
                        BorderBrush="#660EA5E9"
                        Background="#1A0EA5E9"
                        Padding="12,4,4,4"
                        Visibility="{Binding IsMemberFiltered, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock VerticalAlignment="Center" FontSize="12" Foreground="{StaticResource Sky200Brush}">
                            <Run Text="顧客："/><Run Text="{Binding MemberName, Mode=OneWay}" FontWeight="SemiBold"/><Run Text=" で絞り込み中"/>
                        </TextBlock>
                        <Button Content="解除" Margin="8,0,0,0" MinHeight="22" Padding="8,0" Style="{StaticResource AdminOutlineButton}" Click="ClearMemberFilterButton_OnClick"/>
                    </StackPanel>
                </Border>

                <Border Margin="0,16,0,0"
                        Style="{StaticResource RoseBanner}"
                        Visibility="{Binding HasError, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <TextBlock Text="{Binding ErrorMessage}" Style="{StaticResource RoseBannerText}"/>
                </Border>
            </StackPanel>
        </Border>

        <!-- ===== CSV / 顧客別 ===== -->
        <StackPanel Margin="0,24,0,0" Orientation="Horizontal" HorizontalAlignment="Right">
            <TextBlock Text="読み込み中..."
                       Margin="0,0,12,0"
                       VerticalAlignment="Center"
                       FontSize="12"
                       Foreground="{StaticResource Sky300Brush}"
                       Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}"/>
            <Button Content="CSV出力" MinHeight="36" Padding="14,0" Style="{StaticResource AdminOutlineButton}" Click="ExportCsvButton_OnClick"/>
            <Button Content="顧客別に集計を見る →" Margin="8,0,0,0" MinHeight="36" Padding="14,0" Style="{StaticResource AdminOutlineButton}" Click="OpenByMemberButton_OnClick"/>
        </StackPanel>

        <!-- ===== 合計 ===== -->
        <Border Margin="0,24,0,0" Style="{StaticResource PageHeaderCard}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Style="{StaticResource StatBox}">
                    <StackPanel>
                        <TextBlock Text="請求合計（売上）" Style="{StaticResource StatLabel}"/>
                        <TextBlock Text="{Binding InvoiceTotalText}" Style="{StaticResource StatValue}"/>
                    </StackPanel>
                </Border>
                <Border Grid.Column="2" Style="{StaticResource StatBox}">
                    <StackPanel>
                        <TextBlock Text="入金済み合計" Style="{StaticResource StatLabel}"/>
                        <TextBlock Text="{Binding PaidTotalText}" Style="{StaticResource StatValue}" Foreground="#6EE7B7"/>
                    </StackPanel>
                </Border>
                <Border Grid.Column="4" Style="{StaticResource StatBox}">
                    <StackPanel>
                        <TextBlock Text="残額（未回収）" Style="{StaticResource StatLabel}"/>
                        <TextBlock Text="{Binding RemainingTotalText}" Style="{StaticResource StatValue}" Foreground="{StaticResource Amber300Brush}"/>
                    </StackPanel>
                </Border>
                <Border Grid.Column="6" Style="{StaticResource StatBox}">
                    <StackPanel>
                        <TextBlock Text="回収率" Style="{StaticResource StatLabel}"/>
                        <TextBlock Text="{Binding RecoveryRateText}" Style="{StaticResource StatValue}" Foreground="{StaticResource Sky300Brush}"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- ===== 一覧 ===== -->
        <Border Margin="0,24,0,0" Style="{StaticResource PageHeaderCard}">
            <StackPanel>
                <Border Style="{StaticResource InnerTable}">
                    <StackPanel>
                        <Border Style="{StaticResource InnerTableHeader}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="1.8*" MinWidth="170"/>
                                    <ColumnDefinition Width="*" MinWidth="90"/>
                                    <ColumnDefinition Width="100"/>
                                    <ColumnDefinition Width="100"/>
                                    <ColumnDefinition Width="96"/>
                                    <ColumnDefinition Width="100"/>
                                    <ColumnDefinition Width="100"/>
                                    <ColumnDefinition Width="100"/>
                                    <ColumnDefinition Width="100"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="請求書" Style="{StaticResource ListHeaderText}"/>
                                <TextBlock Grid.Column="1" Text="顧客" Style="{StaticResource ListHeaderText}"/>
                                <TextBlock Grid.Column="2" Text="発行日" Style="{StaticResource ListHeaderText}"/>
                                <TextBlock Grid.Column="3" Text="期限" Style="{StaticResource ListHeaderText}"/>
                                <TextBlock Grid.Column="4" Text="ステータス" Style="{StaticResource ListHeaderText}"/>
                                <TextBlock Grid.Column="5" Text="請求" HorizontalAlignment="Right" Style="{StaticResource ListHeaderText}"/>
                                <TextBlock Grid.Column="6" Text="入金済" HorizontalAlignment="Right" Style="{StaticResource ListHeaderText}"/>
                                <TextBlock Grid.Column="7" Text="残額" HorizontalAlignment="Right" Style="{StaticResource ListHeaderText}"/>
                                <TextBlock Grid.Column="8" Text="最終入金" Style="{StaticResource ListHeaderText}"/>
                            </Grid>
                        </Border>

                        <ItemsControl ItemsSource="{Binding Rows}" Focusable="False">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource InnerTableRow}" Padding="0,10">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="1.8*" MinWidth="170"/>
                                                <ColumnDefinition Width="*" MinWidth="90"/>
                                                <ColumnDefinition Width="100"/>
                                                <ColumnDefinition Width="100"/>
                                                <ColumnDefinition Width="96"/>
                                                <ColumnDefinition Width="100"/>
                                                <ColumnDefinition Width="100"/>
                                                <ColumnDefinition Width="100"/>
                                                <ColumnDefinition Width="100"/>
                                            </Grid.ColumnDefinitions>

                                            <Button Grid.Column="0"
                                                    Margin="12,0"
                                                    VerticalAlignment="Center"
                                                    Content="{Binding InvoiceNumber}"
                                                    FontWeight="SemiBold"
                                                    Foreground="{StaticResource Slate100Brush}"
                                                    ToolTip="請求書の詳細を開く"
                                                    Style="{StaticResource CellLinkButton}"
                                                    Click="InvoiceLinkButton_OnClick"/>
                                            <TextBlock Grid.Column="1" Text="{Binding ClientName}" TextTrimming="CharacterEllipsis" Style="{StaticResource ListCell}"/>
                                            <TextBlock Grid.Column="2" Text="{Binding IssuedAtText}" Style="{StaticResource ListCell}"/>
                                            <TextBlock Grid.Column="3" Text="{Binding DueAtText}" Style="{StaticResource ListCell}"/>
                                            <Border Grid.Column="4" Margin="12,0,0,0" Tag="{Binding Status, Converter={StaticResource SalesStatusColor}}" Style="{StaticResource ColorPill}">
                                                <TextBlock Text="{Binding StatusText}" FontSize="11" FontWeight="SemiBold"/>
                                            </Border>
                                            <TextBlock Grid.Column="5" Text="{Binding InvoiceAmount, StringFormat='￥{0:N0}'}" HorizontalAlignment="Right" Foreground="{StaticResource Slate100Brush}" Style="{StaticResource ListCell}"/>
                                            <TextBlock Grid.Column="6" Text="{Binding PaidAmount, StringFormat='￥{0:N0}'}" HorizontalAlignment="Right" Foreground="#6EE7B7" Style="{StaticResource ListCell}"/>
                                            <TextBlock Grid.Column="7" Text="{Binding RemainingAmount, StringFormat='￥{0:N0}'}" HorizontalAlignment="Right" Foreground="{StaticResource Amber300Brush}" Style="{StaticResource ListCell}"/>
                                            <TextBlock Grid.Column="8" Text="{Binding LastPaidAtText}" Style="{StaticResource ListCell}"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <TextBlock Text="該当する売上はありません。">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource InnerTableEmpty}">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Rows.Count}" Value="0">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                </Border>

                <!-- ページ送り -->
                <Grid Margin="0,16,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding PageText}" VerticalAlignment="Center" FontSize="12" Foreground="{StaticResource Slate400Brush}"/>
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Button Content="← 前へ" MinWidth="72" Style="{StaticResource AdminOutlineButton}" Click="PrevPageButton_OnClick"/>
                        <Button Content="次へ →" Margin="8,0,0,0" MinWidth="72" Style="{StaticResource AdminOutlineButton}" Click="NextPageButton_OnClick"/>
                    </StackPanel>
                </Grid>
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
