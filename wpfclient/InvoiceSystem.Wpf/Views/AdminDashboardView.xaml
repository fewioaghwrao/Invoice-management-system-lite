<UserControl x:Class="InvoiceSystem.Wpf.Views.AdminDashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:oxy="http://oxyplot.org/wpf"
             mc:Ignorable="d"
             d:DesignWidth="1150">

    <!-- 管理者ダッシュボード（Next.js: app/dashboards/admin/page.tsx）。DataContext は AdminDashboardViewModel。 -->
    <UserControl.Resources>
        <!-- パネル: rounded-2xl border-slate-800 bg-slate-900/70 p-5 -->
        <Style x:Key="DashPanel" TargetType="Border" BasedOn="{StaticResource Panel}">
            <Setter Property="Padding" Value="20"/>
        </Style>
        <Style x:Key="PanelTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource Slate100Brush}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </UserControl.Resources>

    <StackPanel>
        <!-- 読み込み中 / エラー -->
        <TextBlock Margin="0,0,0,12"
                   Text="読み込み中..."
                   FontSize="12"
                   Foreground="{StaticResource Sky300Brush}"
                   Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}"/>

        <Border Margin="0,0,0,20"
                Style="{StaticResource RoseBanner}"
                Visibility="{Binding HasError, Converter={StaticResource BooleanToVisibilityConverter}}">
            <TextBlock Text="{Binding ErrorMessage}" Style="{StaticResource RoseBannerText}"/>
        </Border>

        <!-- ===== 主要指標（5 列 / gap-3） ===== -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- border-sky-500/40 -->
            <Border Grid.Column="0" Style="{StaticResource KpiCard}" BorderBrush="#660EA5E9">
                <StackPanel>
                    <TextBlock Text="売上合計（請求金額）" Style="{StaticResource KpiLabel}"/>
                    <TextBlock Text="{Binding TotalSalesText}" Style="{StaticResource KpiValue}"/>
                    <TextBlock Text="発行済み請求書の合計" Style="{StaticResource KpiHint}"/>
                </StackPanel>
            </Border>

            <!-- border-amber-400/40 / text-amber-300 -->
            <Border Grid.Column="2" Style="{StaticResource KpiCard}" BorderBrush="#66FBBF24">
                <StackPanel>
                    <TextBlock Text="未入金額" Style="{StaticResource KpiLabel}"/>
                    <TextBlock Text="{Binding UnpaidAmountText}" Style="{StaticResource KpiValue}" Foreground="{StaticResource Amber300Brush}"/>
                    <TextBlock Text="未回収残額の合計" Style="{StaticResource KpiHint}"/>
                </StackPanel>
            </Border>

            <!-- border-slate-700 -->
            <Border Grid.Column="4" Style="{StaticResource KpiCard}" BorderBrush="{StaticResource Slate700Brush}">
                <StackPanel>
                    <TextBlock Text="請求書数" Style="{StaticResource KpiLabel}"/>
                    <TextBlock Text="{Binding InvoiceCountText}" Style="{StaticResource KpiValue}"/>
                    <TextBlock Text="対象年の請求書" Style="{StaticResource KpiHint}"/>
                </StackPanel>
            </Border>

            <!-- border-emerald-500/40 / text-emerald-300 -->
            <Border Grid.Column="6" Style="{StaticResource KpiCard}" BorderBrush="#6610B981">
                <StackPanel>
                    <TextBlock Text="入金数" Style="{StaticResource KpiLabel}"/>
                    <TextBlock Text="{Binding PaymentCountText}" Style="{StaticResource KpiValue}" Foreground="#6EE7B7"/>
                    <TextBlock Text="登録された入金明細" Style="{StaticResource KpiHint}"/>
                </StackPanel>
            </Border>

            <!-- border-indigo-500/40 / text-indigo-200 -->
            <Border Grid.Column="8" Style="{StaticResource KpiCard}" BorderBrush="#666366F1">
                <StackPanel>
                    <TextBlock Text="回収率" Style="{StaticResource KpiLabel}"/>
                    <TextBlock Text="{Binding RecoveryRateText}" Style="{StaticResource KpiValue}" Foreground="#C7D2FE"/>
                    <TextBlock Text="入金済み合計 ÷ 請求合計" Style="{StaticResource KpiHint}"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ===== 未入金一覧 / 月別売上（2 列 / gap-5） ===== -->
        <Grid Margin="0,24,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="20"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- 未入金一覧（Top5） -->
            <Border Grid.Column="0" Style="{StaticResource DashPanel}">
                <StackPanel>
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="未入金一覧（Top5）" Style="{StaticResource PanelTitle}"/>
                        <Button Grid.Column="1"
                                Content="すべて表示 →"
                                Style="{StaticResource PanelLinkButton}"
                                Click="OpenInvoiceListButton_OnClick"/>
                    </Grid>

                    <Border Style="{StaticResource InnerTable}">
                        <StackPanel>
                            <Border Style="{StaticResource InnerTableHeader}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="110"/>
                                        <ColumnDefinition Width="110"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="請求番号" Style="{StaticResource InnerTableHeaderText}"/>
                                    <TextBlock Grid.Column="1" Text="顧客" Style="{StaticResource InnerTableHeaderText}"/>
                                    <TextBlock Grid.Column="2" Text="未入金額" HorizontalAlignment="Right" Style="{StaticResource InnerTableHeaderText}"/>
                                </Grid>
                            </Border>

                            <ItemsControl ItemsSource="{Binding UnpaidInvoices}" Focusable="False">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource InnerTableRow}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="110"/>
                                                    <ColumnDefinition Width="110"/>
                                                </Grid.ColumnDefinitions>

                                                <StackPanel Grid.Column="0" Margin="12,0" VerticalAlignment="Center">
                                                    <Button Content="{Binding InvoiceNumber}"
                                                            Tag="{Binding InvoiceId}"
                                                            ToolTip="請求書の詳細を開く"
                                                            Style="{StaticResource CellLinkButton}"
                                                            Click="UnpaidInvoiceButton_OnClick"/>
                                                    <TextBlock Text="期限超過"
                                                               Margin="0,4,0,0"
                                                               FontSize="11"
                                                               Foreground="{StaticResource Amber300Brush}">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsOverdue}" Value="True">
                                                                        <Setter Property="Visibility" Value="Visible"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </StackPanel>

                                                <TextBlock Grid.Column="1"
                                                           Text="{Binding ClientName}"
                                                           TextTrimming="CharacterEllipsis"
                                                           Style="{StaticResource InnerTableCell}"/>
                                                <TextBlock Grid.Column="2"
                                                           Text="{Binding RemainingTotal, StringFormat='￥{0:N0}'}"
                                                           HorizontalAlignment="Right"
                                                           FontWeight="Medium"
                                                           Foreground="{StaticResource Slate100Brush}"
                                                           Style="{StaticResource InnerTableCell}"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <TextBlock Text="未入金の請求書はありません。">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource InnerTableEmpty}">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding UnpaidInvoices.Count}" Value="0">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>

            <!-- 月別売上（請求金額ベース） -->
            <Border Grid.Column="2" Style="{StaticResource DashPanel}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Margin="0,0,12,0">
                            <TextBlock Text="月別売上（請求金額ベース）" Style="{StaticResource PanelTitle}"/>
                            <TextBlock Margin="0,4,0,0"
                                       FontSize="11"
                                       Foreground="{StaticResource Slate400Brush}"
                                       TextWrapping="Wrap">
                                <Run Text="{Binding SelectedYear, Mode=OneWay}"/><Run Text="年の請求書金額ベースの売上推移です。四半期ごとに絞り込みできます。"/>
                            </TextBlock>
                        </StackPanel>

                        <!-- 四半期の切り替え: rounded-full bg-slate-900/80 px-1 py-1 -->
                        <Border Grid.Column="1"
                                VerticalAlignment="Top"
                                CornerRadius="999"
                                Background="{StaticResource CardBrush}"
                                Padding="4">
                            <StackPanel Orientation="Horizontal">
                                <RadioButton x:Name="QuarterAll" Content="全期間" Tag="0" GroupName="Quarter" IsChecked="True"
                                             Style="{StaticResource QuarterPill}" Click="QuarterButton_OnClick"/>
                                <RadioButton Content="Q1" Tag="1" GroupName="Quarter"
                                             Style="{StaticResource QuarterPill}" Click="QuarterButton_OnClick"/>
                                <RadioButton Content="Q2" Tag="2" GroupName="Quarter"
                                             Style="{StaticResource QuarterPill}" Click="QuarterButton_OnClick"/>
                                <RadioButton Content="Q3" Tag="3" GroupName="Quarter"
                                             Style="{StaticResource QuarterPill}" Click="QuarterButton_OnClick"/>
                                <RadioButton Content="Q4" Tag="4" GroupName="Quarter"
                                             Style="{StaticResource QuarterPill}" Click="QuarterButton_OnClick"/>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- グラフ本体: rounded-xl bg-slate-950/40 px-3 py-3 -->
                    <Border Grid.Row="1"
                            Margin="0,16,0,0"
                            MinHeight="224"
                            CornerRadius="12"
                            Background="{StaticResource Slate950_40Brush}"
                            Padding="8">
                        <oxy:PlotView Model="{Binding MonthlySalesPlotModel}"
                                      Controller="{Binding FixedPlotController}"
                                      Background="Transparent"/>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <!-- ===== 回収率ワースト顧客 TOP5 ===== -->
        <Border Margin="0,24,0,0" Style="{StaticResource DashPanel}">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="回収率ワースト顧客 TOP5" Style="{StaticResource PanelTitle}"/>
                    <Button Grid.Column="1"
                            Content="顧客別集計を見る →"
                            Style="{StaticResource PanelLinkButton}"
                            Click="OpenSalesByMemberButton_OnClick"/>
                </Grid>
                <TextBlock Text="未回収残額がある顧客を、回収率の低い順に表示しています。"
                           Margin="0,12,0,12"
                           Style="{StaticResource SmallMuted}"/>

                <Border Style="{StaticResource InnerTable}">
                    <StackPanel>
                        <Border Style="{StaticResource InnerTableHeader}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="2*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="顧客" Style="{StaticResource InnerTableHeaderText}"/>
                                <TextBlock Grid.Column="1" Text="回収率" HorizontalAlignment="Right" Style="{StaticResource InnerTableHeaderText}"/>
                                <TextBlock Grid.Column="2" Text="未回収" HorizontalAlignment="Right" Style="{StaticResource InnerTableHeaderText}"/>
                                <TextBlock Grid.Column="3" Text="請求合計" HorizontalAlignment="Right" Style="{StaticResource InnerTableHeaderText}"/>
                            </Grid>
                        </Border>

                        <ItemsControl ItemsSource="{Binding WorstCustomers}" Focusable="False">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource InnerTableRow}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="2*"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>

                                            <Button Grid.Column="0"
                                                    Margin="12,0"
                                                    Content="{Binding MemberName}"
                                                    Tag="{Binding}"
                                                    ToolTip="この顧客の売上一覧を開く"
                                                    Foreground="{StaticResource Slate100Brush}"
                                                    Style="{StaticResource CellLinkButton}"
                                                    Click="WorstCustomerButton_OnClick"/>
                                            <TextBlock Grid.Column="1"
                                                       Text="{Binding RecoveryRate, StringFormat={}{0:F1}%}"
                                                       HorizontalAlignment="Right"
                                                       Foreground="{StaticResource Sky200Brush}"
                                                       Style="{StaticResource InnerTableCell}"/>
                                            <TextBlock Grid.Column="2"
                                                       Text="{Binding RemainingTotal, StringFormat='￥{0:N0}'}"
                                                       HorizontalAlignment="Right"
                                                       Foreground="{StaticResource Amber300Brush}"
                                                       Style="{StaticResource InnerTableCell}"/>
                                            <TextBlock Grid.Column="3"
                                                       Text="{Binding InvoiceTotal, StringFormat='￥{0:N0}'}"
                                                       HorizontalAlignment="Right"
                                                       Foreground="{StaticResource Slate100Brush}"
                                                       Style="{StaticResource InnerTableCell}"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <TextBlock Text="未回収残額のある顧客はありません。">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource InnerTableEmpty}">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding WorstCustomers.Count}" Value="0">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
