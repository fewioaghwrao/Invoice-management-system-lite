<UserControl x:Class="InvoiceSystem.Wpf.Views.MemberProfileView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignWidth="1100"
             Loaded="View_OnLoaded">

    <!-- 登録情報（Next.js: account/profile/page.tsx + AccountProfileFormClient.tsx）。DataContext は MemberProfileViewModel。 -->
    <StackPanel>
        <TextBlock Text="登録情報" Style="{StaticResource SectionTitle}"/>
        <TextBlock Text="請求書の宛名や連絡先に使用される情報です。"
                   Margin="0,4,0,0"
                   Style="{StaticResource SmallMuted}"/>

        <!-- rounded-2xl border-slate-800 bg-slate-900/80 p-6 shadow-md -->
        <Border Margin="0,16,0,0"
                Padding="24"
                Style="{StaticResource Panel}"
                Background="{StaticResource CardBrush}">
            <StackPanel>
                <TextBlock Text="登録情報の確認・変更"
                           Margin="0,0,0,16"
                           FontSize="14"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource Slate200Brush}"/>

                <!-- 2 列（gap-4） -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="16"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="16"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Grid.Column="0">
                        <TextBlock Text="氏名 *" Style="{StaticResource CompactLabel}"/>
                        <TextBox x:Name="NameTextBox"
                                 Style="{StaticResource CompactTextBox}"
                                 Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>

                    <StackPanel Grid.Row="0" Grid.Column="2">
                        <TextBlock Text="メールアドレス *" Style="{StaticResource CompactLabel}"/>
                        <TextBox Style="{StaticResource CompactTextBox}"
                                 Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}"/>
                        <TextBlock Text="メールアドレスを変更しても確認メールは送信されません。"
                                   Margin="0,4,0,0"
                                   Style="{StaticResource TinyMuted}"/>
                    </StackPanel>

                    <StackPanel Grid.Row="2" Grid.Column="0">
                        <TextBlock Text="電話番号" Style="{StaticResource CompactLabel}"/>
                        <TextBox Style="{StaticResource CompactTextBox}"
                                 Text="{Binding Phone, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>

                    <StackPanel Grid.Row="2" Grid.Column="2">
                        <TextBlock Text="郵便番号" Style="{StaticResource CompactLabel}"/>
                        <TextBox Style="{StaticResource CompactTextBox}"
                                 Text="{Binding PostalCode, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>

                    <StackPanel Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="3">
                        <TextBlock Text="住所" Style="{StaticResource CompactLabel}"/>
                        <TextBox Style="{StaticResource CompactTextBox}"
                                 Text="{Binding Address, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>
                </Grid>

                <!-- エラー / 完了メッセージ -->
                <Border Margin="0,16,0,0"
                        Style="{StaticResource RoseBanner}"
                        CornerRadius="8"
                        Visibility="{Binding ErrorMessageVisibility}">
                    <TextBlock Text="{Binding ErrorMessage}" Style="{StaticResource RoseBannerText}"/>
                </Border>

                <Border Margin="0,16,0,0"
                        Style="{StaticResource SuccessBanner}"
                        CornerRadius="8"
                        Visibility="{Binding InfoMessageVisibility}">
                    <TextBlock Text="{Binding InfoMessage}" Style="{StaticResource SuccessBannerText}"/>
                </Border>

                <!-- 退会する / 保存 -->
                <Grid Margin="0,24,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Button Grid.Column="0"
                            Content="退会する"
                            Style="{StaticResource RoseSoftButton}"
                            Command="{Binding WithdrawCommand}"/>

                    <TextBlock Grid.Column="1"
                               Margin="0,0,12,0"
                               HorizontalAlignment="Right"
                               VerticalAlignment="Center"
                               FontSize="12"
                               Foreground="{StaticResource Slate400Brush}"
                               Text="{Binding LoadingMessage}"
                               Visibility="{Binding LoadingVisibility}"/>

                    <Button Grid.Column="2"
                            Content="保存"
                            Style="{StaticResource EmeraldButton}"
                            Command="{Binding SaveCommand}"/>
                </Grid>
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
