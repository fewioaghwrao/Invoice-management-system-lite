<UserControl x:Class="InvoiceSystem.Wpf.Views.MemberPaymentStatusView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignWidth="1100"
             Loaded="View_OnLoaded">

    <!-- 未入金の確認（Next.js: account/unpaid/page.tsx）。DataContext は MemberPaymentStatusViewModel。 -->
    <UserControl.Resources>
        <!-- サマリーカード: rounded-2xl border-slate-800 bg-slate-900/70 p-4 -->
        <Style x:Key="SummaryLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="{StaticResource Slate400Brush}"/>
        </Style>
        <Style x:Key="SummaryValue" TargetType="TextBlock">
            <Setter Property="Margin" Value="0,4,0,0"/>
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource Slate100Brush}"/>
        </Style>
    </UserControl.Resources>

    <StackPanel>
        <!-- 上部導線 -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="未入金の確認"
                           FontSize="14"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource Slate100Brush}"/>
                <TextBlock Text="未入金 / 一部入金の請求書をまとめて確認できます。"
                           Margin="0,4,0,0"
                           Style="{StaticResource SmallMuted}"/>
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Margin="0,0,12,0"
                           VerticalAlignment="Center"
                           FontSize="12"
                           Foreground="{StaticResource Sky300Brush}"
                           Text="{Binding LoadingMessage}"
                           Visibility="{Binding LoadingVisibility}"/>
                <Button Content="請求書一覧へ →"
                        FontSize="12"
                        Style="{StaticResource PlainLinkButton}"
                        Click="OpenInvoiceListButton_OnClick"/>
            </StackPanel>
        </Grid>

        <!-- 期限超過のお知らせ -->
        <Border Margin="0,24,0,0"
                Style="{StaticResource AmberBannerBright}"
                Visibility="{Binding OverdueBannerVisibility}">
            <StackPanel>
                <TextBlock Text="⚠ お支払いの遅れている請求があります"
                           FontSize="16"
                           FontWeight="SemiBold"
                           Foreground="#FDE68A"/>
                <TextBlock Text="期限超過の行にラベルが表示されています。"
                           Margin="0,4,0,0"
                           FontSize="12"
                           Foreground="#CCFDE68A"/>
            </StackPanel>
        </Border>

        <!-- サマリー（3 列 / gap-3） -->
        <Grid Margin="0,24,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Padding="16" Style="{StaticResource Panel}">
                <StackPanel>
                    <TextBlock Text="未払い件数" Style="{StaticResource SummaryLabel}"/>
                    <TextBlock Text="{Binding UnpaidCountText}" Style="{StaticResource SummaryValue}"/>
                </StackPanel>
            </Border>

            <Border Grid.Column="2" Padding="16" Style="{StaticResource Panel}">
                <StackPanel>
                    <TextBlock Text="未払い残額合計" Style="{StaticResource SummaryLabel}"/>
                    <TextBlock Text="{Binding RemainingTotalText}" Style="{StaticResource SummaryValue}"/>
                    <TextBlock Text="※入金割当から算出しております。" Margin="0,4,0,0" Style="{StaticResource TinyMuted}"/>
                </StackPanel>
            </Border>

            <Border Grid.Column="4" Padding="16" Style="{StaticResource Panel}">
                <StackPanel>
                    <TextBlock Text="期限超過" Style="{StaticResource SummaryLabel}"/>
                    <TextBlock Text="{Binding OverdueCountText}" Style="{StaticResource SummaryValue}"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- 未払い一覧 -->
        <Border Margin="0,24,0,0" Style="{StaticResource Panel}" ClipToBounds="True">
            <StackPanel>
                <Grid Margin="16,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="未払い一覧" FontSize="12" Foreground="{StaticResource Slate300Brush}"/>
                    <TextBlock Grid.Column="1" Text="※ PDFは既定のアプリで開きます" Style="{StaticResource TinyMuted}"/>
                </Grid>

                <Border Style="{StaticResource TableHeaderRow}"
                        BorderBrush="{StaticResource Slate800Brush}"
                        BorderThickness="0,1,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" MinWidth="210"/>
                            <ColumnDefinition Width="140"/>
                            <ColumnDefinition Width="150"/>
                            <ColumnDefinition Width="140"/>
                            <ColumnDefinition Width="150"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="請求書番号" Style="{StaticResource TableHeaderText}"/>
                        <TextBlock Grid.Column="1" Text="支払期限" Style="{StaticResource TableHeaderText}"/>
                        <TextBlock Grid.Column="2" Text="残額" HorizontalAlignment="Right" Style="{StaticResource TableHeaderText}"/>
                        <TextBlock Grid.Column="3" Text="ステータス" Style="{StaticResource TableHeaderText}"/>
                        <TextBlock Grid.Column="4" Text="操作" HorizontalAlignment="Right" Style="{StaticResource TableHeaderText}"/>
                    </Grid>
                </Border>

                <ItemsControl ItemsSource="{Binding Rows}" Focusable="False">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource TableRow}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" MinWidth="210"/>
                                        <ColumnDefinition Width="140"/>
                                        <ColumnDefinition Width="150"/>
                                        <ColumnDefinition Width="140"/>
                                        <ColumnDefinition Width="150"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0" Margin="12,0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding InvoiceNumber}"
                                                   FontSize="14"
                                                   FontWeight="SemiBold"
                                                   Foreground="{StaticResource Slate100Brush}"
                                                   TextTrimming="CharacterEllipsis"/>
                                        <Border Style="{StaticResource OverdueBadge}"
                                                Visibility="{Binding OverdueBadgeVisibility}">
                                            <TextBlock Style="{StaticResource OverdueBadgeText}"/>
                                        </Border>
                                    </StackPanel>

                                    <TextBlock Grid.Column="1" Text="{Binding DueAtText}" Style="{StaticResource TableCellText}"/>
                                    <TextBlock Grid.Column="2" Text="{Binding RemainingAmountText}" HorizontalAlignment="Right" Style="{StaticResource TableCellStrong}"/>
                                    <TextBlock Grid.Column="3" Text="{Binding StatusName}" Style="{StaticResource TableCellText}"/>

                                    <StackPanel Grid.Column="4"
                                                Margin="12,0"
                                                Orientation="Horizontal"
                                                HorizontalAlignment="Right"
                                                VerticalAlignment="Center">
                                        <Button Content="詳細"
                                                Style="{StaticResource DetailLinkButton}"
                                                Command="{Binding DataContext.OpenDetailCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding}"/>
                                        <Button Margin="8,0,0,0"
                                                Style="{StaticResource PlainLinkButton}"
                                                ToolTip="PDF表示"
                                                Command="{Binding DataContext.OpenPdfCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding}">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="&#xE8A5;" Margin="0,0,4,0" Style="{StaticResource IconGlyph}"/>
                                                <TextBlock Text="PDF" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBlock Text="未払いの請求書はありません。">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource TableEmptyText}">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Rows.Count}" Value="0">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
