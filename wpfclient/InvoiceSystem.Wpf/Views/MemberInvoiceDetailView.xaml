<UserControl x:Class="InvoiceSystem.Wpf.Views.MemberInvoiceDetailView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignWidth="1100"
             Loaded="View_OnLoaded">

    <!-- 請求書詳細（Next.js: account/invoices/[id]/page.tsx）。DataContext は MemberInvoiceDetailViewModel。 -->
    <UserControl.Resources>
        <!-- 金額カード: rounded-xl border-slate-800 bg-slate-950/30 p-4 -->
        <Style x:Key="AmountBox" TargetType="Border">
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="{StaticResource Slate800Brush}"/>
            <Setter Property="Background" Value="{StaticResource Slate950_30Brush}"/>
            <Setter Property="Padding" Value="16"/>
        </Style>
        <Style x:Key="AmountLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="{StaticResource Slate400Brush}"/>
        </Style>
        <Style x:Key="AmountValue" TargetType="TextBlock">
            <Setter Property="Margin" Value="0,4,0,0"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource Slate100Brush}"/>
        </Style>
    </UserControl.Resources>

    <StackPanel>
        <!-- 上部導線 -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Button x:Name="BackButton"
                    Content="← 請求書一覧へ戻る"
                    FontSize="12"
                    VerticalAlignment="Center"
                    Style="{StaticResource PlainLinkButton}"
                    Command="{Binding BackCommand}"/>

            <TextBlock Grid.Column="1"
                       Margin="12,0"
                       HorizontalAlignment="Right"
                       VerticalAlignment="Center"
                       FontSize="12"
                       Foreground="{StaticResource Sky300Brush}"
                       Text="{Binding LoadingMessage}"
                       Visibility="{Binding LoadingVisibility}"/>

            <Button Grid.Column="2"
                    Style="{StaticResource SmallOutlineButton}"
                    Command="{Binding OpenPdfCommand}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE8A5;" Margin="0,0,6,0" FontSize="12" Style="{StaticResource IconGlyph}"/>
                    <TextBlock Text="PDF表示" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
        </Grid>

        <!-- 取得エラー -->
        <Border Margin="0,24,0,0">
            <Border.Style>
                <Style TargetType="Border" BasedOn="{StaticResource RoseBanner}">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding ErrorMessage}" Value="">
                            <Setter Property="Visibility" Value="Collapsed"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding ErrorMessage}" Value="{x:Null}">
                            <Setter Property="Visibility" Value="Collapsed"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <TextBlock Text="{Binding ErrorMessage}" Style="{StaticResource RoseBannerText}"/>
        </Border>

        <!-- 本体: rounded-2xl border-slate-800 bg-slate-900/70 p-6 -->
        <Border Margin="0,24,0,0" Padding="24" Style="{StaticResource Panel}">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel>
                        <TextBlock Text="請求書番号" FontSize="11" Foreground="{StaticResource Slate400Brush}"/>
                        <TextBlock Text="{Binding InvoiceNumber}"
                                   Margin="0,4,0,0"
                                   FontSize="18"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource Slate100Brush}"/>

                        <StackPanel Margin="0,12,0,0" Orientation="Horizontal">
                            <!-- ステータス: rounded-full bg-slate-950/40 border-slate-700 text-[11px] text-slate-200 -->
                            <Border CornerRadius="999"
                                    BorderThickness="1"
                                    BorderBrush="{StaticResource Slate700Brush}"
                                    Background="{StaticResource Slate950_40Brush}"
                                    Padding="8,3">
                                <TextBlock Text="{Binding StatusName}"
                                           FontSize="11"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource Slate200Brush}"/>
                            </Border>

                            <!-- 期限超過: bg-amber-500/10 border-amber-500/30 text-amber-300 -->
                            <Border Margin="8,0,0,0"
                                    CornerRadius="999"
                                    BorderThickness="1"
                                    BorderBrush="#4DF59E0B"
                                    Background="#1AF59E0B"
                                    Padding="8,3"
                                    Visibility="{Binding OverdueVisibility}">
                                <TextBlock Text="⚠ 期限超過"
                                           FontSize="11"
                                           FontWeight="SemiBold"
                                           Foreground="#FCD34D"/>
                            </Border>
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Grid.Column="1">
                        <TextBlock HorizontalAlignment="Right" FontSize="12" Foreground="{StaticResource Slate200Brush}">
                            <Run Text="請求日：" Foreground="{StaticResource Slate400Brush}"/><Run Text="{Binding InvoiceDateText, Mode=OneWay}"/>
                        </TextBlock>
                        <TextBlock Margin="0,4,0,0" HorizontalAlignment="Right" FontSize="12" Foreground="{StaticResource Slate200Brush}">
                            <Run Text="支払期限：" Foreground="{StaticResource Slate400Brush}"/><Run Text="{Binding DueDateText, Mode=OneWay}"/>
                        </TextBlock>
                    </StackPanel>
                </Grid>

                <!-- 金額（3 列 / gap-3） -->
                <Grid Margin="0,20,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Style="{StaticResource AmountBox}">
                        <StackPanel>
                            <TextBlock Text="請求金額" Style="{StaticResource AmountLabel}"/>
                            <TextBlock Text="{Binding TotalAmountText}" Style="{StaticResource AmountValue}"/>
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="2" Style="{StaticResource AmountBox}">
                        <StackPanel>
                            <TextBlock Text="入金済み" Style="{StaticResource AmountLabel}"/>
                            <TextBlock Text="{Binding PaidAmountText}" Style="{StaticResource AmountValue}"/>
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="4" Style="{StaticResource AmountBox}">
                        <StackPanel>
                            <TextBlock Text="残額" Style="{StaticResource AmountLabel}"/>
                            <TextBlock Text="{Binding RemainingAmountText}" Style="{StaticResource AmountValue}"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- 備考 -->
                <TextBlock Text="備考"
                           Margin="0,20,0,0"
                           FontSize="11"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource Slate200Brush}"/>
                <Border Margin="0,8,0,0" Style="{StaticResource AmountBox}">
                    <TextBlock Text="{Binding Remarks}"
                               FontSize="14"
                               Foreground="{StaticResource Slate200Brush}"
                               TextWrapping="Wrap"/>
                </Border>
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
