<UserControl x:Class="InvoiceSystem.Wpf.Views.RegisterView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignWidth="800"
             Loaded="RegisterView_OnLoaded">

    <!-- Next.js frontend/src/app/auth/register/page.tsx に合わせたレイアウト。LoginWindow 内に差し込んで表示する。 -->
    <UserControl.Resources>
        <!-- 必須マーク: text-red-400 -->
        <Style x:Key="RequiredMark" TargetType="Run">
            <Setter Property="Foreground" Value="{StaticResource Red400Brush}"/>
        </Style>

        <!-- h-1.5 w-1.5 rounded-full bg-sky-400 -->
        <Style x:Key="BulletDot" TargetType="Ellipse">
            <Setter Property="Width" Value="6"/>
            <Setter Property="Height" Value="6"/>
            <Setter Property="Margin" Value="0,8,8,0"/>
            <Setter Property="VerticalAlignment" Value="Top"/>
            <Setter Property="Fill" Value="{StaticResource Sky400DotBrush}"/>
        </Style>

        <Style x:Key="BulletText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Foreground" Value="{StaticResource Slate300Brush}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="LineHeight" Value="22"/>
        </Style>
    </UserControl.Resources>

    <!-- 外側カード: max-w-3xl rounded-3xl border-slate-800 bg-slate-900/80 p-8 shadow-2xl -->
    <Grid MaxWidth="768">
        <Border CornerRadius="24" Background="{StaticResource CardBrush}">
            <Border.Effect>
                <DropShadowEffect BlurRadius="50" ShadowDepth="20" Direction="270" Opacity="0.35" Color="#000000"/>
            </Border.Effect>
        </Border>

        <Border CornerRadius="24"
                BorderBrush="{StaticResource Slate800Brush}"
                BorderThickness="1"
                Padding="32">
            <StackPanel>
                <Button Content="← ログインに戻る"
                        Margin="-4,0,0,16"
                        Style="{StaticResource BackLinkButton}"
                        Click="BackButton_OnClick"/>

                <!-- 説明 -->
                <Border Style="{StaticResource BrandPill}">
                    <TextBlock Text="Invoice Management System" Style="{StaticResource BrandPillText}"/>
                </Border>

                <TextBlock Text="新規会員登録" Margin="0,16,0,0" Style="{StaticResource PageTitle}"/>

                <TextBlock Margin="0,8,0,0" Style="{StaticResource PageDescription}">
                    請求書・入金ステータスダッシュボードのデモ用アカウントを登録します。<LineBreak/>
                    氏名とメールアドレス、パスワードだけでも登録可能です。
                </TextBlock>

                <!-- mt-8 space-y-3 / 先頭に sky-400 の丸 -->
                <StackPanel Margin="0,32,0,0">
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Ellipse Style="{StaticResource BulletDot}"/>
                        <TextBlock Grid.Column="1" Text="登録後は、請求書一覧・入金状況を閲覧できるようになります。" Style="{StaticResource BulletText}"/>
                    </Grid>
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Ellipse Style="{StaticResource BulletDot}"/>
                        <TextBlock Grid.Column="1" Text="メールアドレスはログインIDとして使用します。" Style="{StaticResource BulletText}"/>
                    </Grid>
                    <Grid Margin="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Ellipse Style="{StaticResource BulletDot}"/>
                        <TextBlock Grid.Column="1" Text="ダミー情報でも問題ありません（ポートフォリオ用）。" Style="{StaticResource BulletText}"/>
                    </Grid>
                </StackPanel>

                <!-- フォーム: rounded-2xl bg-slate-900/80 p-6 shadow-lg（gap-10） -->
                <Grid Margin="0,28,0,0">
                    <Border CornerRadius="16" Background="{StaticResource CardBrush}">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="18" ShadowDepth="6" Direction="270" Opacity="0.3" Color="#000000"/>
                        </Border.Effect>
                    </Border>

                    <StackPanel Margin="24">
                        <!-- エラー / 成功 -->
                        <Border Margin="0,0,0,16"
                                Style="{StaticResource ErrorBanner}"
                                Visibility="{Binding HasError, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <TextBlock Text="{Binding ErrorMessage}" Style="{StaticResource ErrorBannerText}"/>
                        </Border>

                        <Border Margin="0,0,0,16"
                                Style="{StaticResource SuccessBanner}"
                                Visibility="{Binding HasSuccess, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <TextBlock Text="{Binding SuccessMessage}" Style="{StaticResource SuccessBannerText}"/>
                        </Border>

                        <!-- 氏名 -->
                        <TextBlock Style="{StaticResource FieldLabel}">
                            氏名 <Run Text="*" Style="{StaticResource RequiredMark}"/>
                        </TextBlock>
                        <TextBox x:Name="NameTextBox"
                                 Style="{StaticResource ModernTextBox}"
                                 Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"/>

                        <!-- メールアドレス -->
                        <TextBlock Margin="0,16,0,4" Style="{StaticResource FieldLabel}">
                            メールアドレス <Run Text="*" Style="{StaticResource RequiredMark}"/>
                        </TextBlock>
                        <TextBox Style="{StaticResource ModernTextBox}"
                                 Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}"/>

                        <!-- パスワード -->
                        <TextBlock Margin="0,16,0,4" Style="{StaticResource FieldLabel}">
                            パスワード <Run Text="*" Style="{StaticResource RequiredMark}"/>
                        </TextBlock>
                        <Grid>
                            <PasswordBox x:Name="PasswordBox"
                                         Style="{StaticResource ModernPasswordBox}"
                                         Padding="12,0,72,0"
                                         PasswordChanged="PasswordBox_OnPasswordChanged"/>

                            <TextBox x:Name="VisiblePasswordTextBox"
                                     Style="{StaticResource ModernTextBox}"
                                     Padding="12,0,72,0"
                                     Visibility="Collapsed"
                                     TextChanged="VisiblePasswordTextBox_OnTextChanged"/>

                            <TextBlock x:Name="PasswordPlaceholder"
                                       Text="8文字以上を推奨"
                                       Margin="15,0,0,0"
                                       VerticalAlignment="Center"
                                       FontSize="14"
                                       Foreground="{StaticResource PlaceholderBrush}"
                                       IsHitTestVisible="False"/>

                            <Button x:Name="TogglePasswordButton"
                                    Style="{StaticResource GhostButton}"
                                    Content="表示"
                                    HorizontalAlignment="Right"
                                    Margin="0,5,8,5"
                                    IsTabStop="False"
                                    Click="TogglePasswordButton_OnClick"/>
                        </Grid>
                        <TextBlock Text="英数字・記号を組み合わせた8文字以上のパスワードを推奨します。"
                                   Style="{StaticResource FieldHint}"/>

                        <!-- 郵便番号 / 電話番号（md:grid-cols-2 gap-3） -->
                        <Grid Margin="0,16,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="郵便番号" Style="{StaticResource FieldLabel}"/>
                                <TextBox Style="{StaticResource ModernTextBox}"
                                         Tag="例）1000001"
                                         Text="{Binding PostalCode, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <TextBlock Text="電話番号" Style="{StaticResource FieldLabel}"/>
                                <TextBox Style="{StaticResource ModernTextBox}"
                                         Tag="例）090-1234-5678"
                                         Text="{Binding Phone, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>
                        </Grid>

                        <!-- 住所 -->
                        <TextBlock Text="住所" Margin="0,16,0,4" Style="{StaticResource FieldLabel}"/>
                        <TextBox Style="{StaticResource ModernTextBox}"
                                 Tag="例）東京都千代田区1-1-1"
                                 Text="{Binding Address, UpdateSourceTrigger=PropertyChanged}"/>

                        <!-- 送信（Enter キーでも実行） -->
                        <Button Margin="0,24,0,0"
                                IsDefault="True"
                                Command="{Binding RegisterCommand}">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
                                    <Setter Property="Content" Value="アカウントを作成する"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsLoading}" Value="True">
                                            <Setter Property="Content" Value="登録中..."/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>

                        <!-- すでにアカウントをお持ちですか？ ログインはこちら -->
                        <StackPanel Margin="0,16,0,0"
                                    Orientation="Horizontal"
                                    HorizontalAlignment="Center">
                            <TextBlock Text="すでにアカウントをお持ちですか？"
                                       VerticalAlignment="Center"
                                       FontSize="12"
                                       Foreground="{StaticResource Slate400Brush}"/>
                            <Button Content="ログインはこちら"
                                    FontWeight="Medium"
                                    Style="{StaticResource LinkButton}"
                                    Click="BackButton_OnClick"/>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
