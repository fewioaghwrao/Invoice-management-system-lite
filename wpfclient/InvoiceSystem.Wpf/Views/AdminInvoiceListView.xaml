<UserControl x:Class="InvoiceSystem.Wpf.Views.AdminInvoiceListView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignWidth="1150">

    <!-- 請求書一覧（管理者）（Next.js: app/invoices/page.tsx）。DataContext は InvoiceListViewModel。 -->
    <UserControl.Resources>
        <Style x:Key="ChipButton" TargetType="Button" BasedOn="{StaticResource AdminOutlineButton}">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
        </Style>
        <Style x:Key="ListHeaderText" TargetType="TextBlock" BasedOn="{StaticResource InnerTableHeaderText}">
            <Setter Property="Margin" Value="16,0"/>
        </Style>
        <Style x:Key="ListCell" TargetType="TextBlock" BasedOn="{StaticResource InnerTableCell}">
            <Setter Property="Margin" Value="16,0"/>
        </Style>
    </UserControl.Resources>

    <StackPanel>
        <!-- ===== ページ見出し ===== -->
        <Border Style="{StaticResource PageHeaderCard}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <Button Content="ダッシュボード" Style="{StaticResource BreadcrumbButton}" Click="BreadcrumbDashboard_OnClick"/>
                        <TextBlock Text=" / " Style="{StaticResource BreadcrumbText}"/>
                        <TextBlock Text="請求書一覧" Style="{StaticResource BreadcrumbText}"/>
                    </StackPanel>
                    <TextBlock Text="請求書一覧（管理者）" Margin="0,6,0,0" Style="{StaticResource PageHeaderTitle}"/>
                    <TextBlock Text="請求番号・会員名・ステータス・請求日で検索し、入金状況や支払期限を一覧で確認できます。"
                               Margin="0,6,0,0"
                               Style="{StaticResource SmallMuted}"/>
                </StackPanel>
                <Button Grid.Column="1"
                        Content="＋ 新規作成"
                        VerticalAlignment="Center"
                        Style="{StaticResource SkyButton}"
                        Click="CreateButton_OnClick"/>
            </Grid>
        </Border>

        <!-- ===== 検索条件 ===== -->
        <Border Margin="0,24,0,0" Padding="16" Style="{StaticResource PageHeaderCard}">
            <StackPanel>
                <!-- クイック検索 -->
                <Border CornerRadius="12"
                        BorderThickness="1"
                        BorderBrush="{StaticResource Slate800Brush}"
                        Background="{StaticResource Slate950_40Brush}"
                        Padding="12,10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="クイック検索：" Margin="0,0,8,0" VerticalAlignment="Center" FontSize="11" Foreground="{StaticResource Slate400Brush}"/>
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <Button Content="FIX（デモ見本）"
                                    ToolTip="請求番号に FIX を含む請求書を表示"
                                    Style="{StaticResource ChipButton}"
                                    Click="QuickFixButton_OnClick"/>
                            <Button Content="OVERDUE（期限超過）"
                                    ToolTip="ステータスが期限超過の請求書を表示"
                                    Style="{StaticResource ChipButton}"
                                    Click="QuickOverdueButton_OnClick"/>
                        </StackPanel>
                        <Button Grid.Column="2"
                                Content="クリア"
                                MinWidth="80"
                                Style="{StaticResource AdminOutlineButton}"
                                Click="ResetButton_OnClick"/>
                    </Grid>
                </Border>

                <!-- 条件 -->
                <Grid Margin="0,16,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="請求番号" Style="{StaticResource AdminFieldLabel}"/>
                        <TextBox Style="{StaticResource AdminTextBox}"
                                 Tag="例：INV-001"
                                 Text="{Binding InvoiceNumber, UpdateSourceTrigger=PropertyChanged}"
                                 KeyDown="SearchField_OnKeyDown"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <TextBlock Text="会員名" Style="{StaticResource AdminFieldLabel}"/>
                        <TextBox Style="{StaticResource AdminTextBox}"
                                 Tag="例：Test User"
                                 Text="{Binding MemberName, UpdateSourceTrigger=PropertyChanged}"
                                 KeyDown="SearchField_OnKeyDown"/>
                    </StackPanel>

                    <StackPanel Grid.Column="4">
                        <TextBlock Text="ステータス" Style="{StaticResource AdminFieldLabel}"/>
                        <ComboBox Style="{StaticResource AdminComboBox}"
                                  ItemsSource="{Binding StatusOptions}"
                                  SelectedItem="{Binding SelectedStatus}"
                                  DisplayMemberPath="Name"/>
                    </StackPanel>

                    <StackPanel Grid.Column="6">
                        <TextBlock Text="請求日（From）" Style="{StaticResource AdminFieldLabel}"/>
                        <Border Style="{StaticResource DateBox}">
                            <DatePicker Style="{StaticResource DateBoxPicker}" SelectedDate="{Binding FromInvoiceDate}"/>
                        </Border>
                    </StackPanel>

                    <StackPanel Grid.Column="8">
                        <TextBlock Text="請求日（To）" Style="{StaticResource AdminFieldLabel}"/>
                        <Border Style="{StaticResource DateBox}">
                            <DatePicker Style="{StaticResource DateBoxPicker}" SelectedDate="{Binding ToInvoiceDate}"/>
                        </Border>
                    </StackPanel>
                </Grid>

                <Grid Margin="0,16,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="3*"/>
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="0" Content="検索" Style="{StaticResource SkyButton}" Click="SearchButton_OnClick"/>
                    <Button Grid.Column="2" Content="リセット" Style="{StaticResource AdminOutlineButton}" Click="ResetButton_OnClick"/>
                    <TextBlock Grid.Column="4"
                               Text="読み込み中..."
                               VerticalAlignment="Center"
                               FontSize="12"
                               Foreground="{StaticResource Sky300Brush}"
                               Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                </Grid>

                <Border Margin="0,16,0,0"
                        Style="{StaticResource RoseBanner}"
                        Visibility="{Binding HasError, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <TextBlock Text="{Binding ErrorMessage}" Style="{StaticResource RoseBannerText}"/>
                </Border>
            </StackPanel>
        </Border>

        <!-- ===== 一覧: rounded-2xl border-slate-800 bg-slate-900/80 ===== -->
        <Border Margin="0,24,0,0" Style="{StaticResource PageHeaderCard}" Padding="0" ClipToBounds="True">
            <StackPanel>
                <Border Background="{StaticResource Slate950_40Brush}" CornerRadius="16,16,0,0" Padding="0,12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="2*" MinWidth="180"/>
                            <ColumnDefinition Width="*" MinWidth="110"/>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="110"/>
                            <ColumnDefinition Width="150"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="請求日" Style="{StaticResource ListHeaderText}"/>
                        <TextBlock Grid.Column="1" Text="請求番号" Style="{StaticResource ListHeaderText}"/>
                        <TextBlock Grid.Column="2" Text="会員名" Style="{StaticResource ListHeaderText}"/>
                        <TextBlock Grid.Column="3" Text="請求金額" HorizontalAlignment="Right" Style="{StaticResource ListHeaderText}"/>
                        <TextBlock Grid.Column="4" Text="支払期限" Style="{StaticResource ListHeaderText}"/>
                        <TextBlock Grid.Column="5" Text="ステータス" Style="{StaticResource ListHeaderText}"/>
                        <TextBlock Grid.Column="6" Text="操作" HorizontalAlignment="Right" Style="{StaticResource ListHeaderText}"/>
                    </Grid>
                </Border>

                <ItemsControl ItemsSource="{Binding Invoices}" Focusable="False">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource InnerTableRow}" Padding="0,10" MinHeight="54">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="120"/>
                                        <ColumnDefinition Width="2*" MinWidth="180"/>
                                        <ColumnDefinition Width="*" MinWidth="110"/>
                                        <ColumnDefinition Width="120"/>
                                        <ColumnDefinition Width="120"/>
                                        <ColumnDefinition Width="110"/>
                                        <ColumnDefinition Width="150"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Column="0" Text="{Binding InvoiceDate, StringFormat=yyyy-MM-dd}" Style="{StaticResource ListCell}"/>

                                    <Button Grid.Column="1"
                                            Margin="16,0"
                                            VerticalAlignment="Center"
                                            Content="{Binding InvoiceNumber}"
                                            FontWeight="SemiBold"
                                            Foreground="{StaticResource Sky300Brush}"
                                            Style="{StaticResource CellLinkButton}"
                                            Click="DetailButton_OnClick"/>

                                    <TextBlock Grid.Column="2" Text="{Binding MemberName}" TextTrimming="CharacterEllipsis" Style="{StaticResource ListCell}"/>
                                    <TextBlock Grid.Column="3"
                                               Text="{Binding TotalAmount, StringFormat='￥{0:N0}'}"
                                               HorizontalAlignment="Right"
                                               Foreground="{StaticResource Slate50Brush}"
                                               Style="{StaticResource ListCell}"/>
                                    <TextBlock Grid.Column="4" Text="{Binding DueDate, StringFormat=yyyy-MM-dd}" Style="{StaticResource ListCell}"/>

                                    <Border Grid.Column="5"
                                            Margin="16,0,0,0"
                                            Style="{StaticResource StatusPill}"
                                            Background="{Binding StatusBackground}"
                                            BorderBrush="{Binding StatusBorderBrush}">
                                        <TextBlock Text="{Binding StatusName}"
                                                   FontSize="11"
                                                   FontWeight="SemiBold"
                                                   Foreground="{Binding StatusForeground}"/>
                                    </Border>

                                    <StackPanel Grid.Column="6"
                                                Margin="16,0"
                                                Orientation="Horizontal"
                                                HorizontalAlignment="Right"
                                                VerticalAlignment="Center">
                                        <Button Content="詳細" Style="{StaticResource AdminOutlineButton}" Click="DetailButton_OnClick"/>
                                        <Button Content="督促"
                                                Margin="8,0,0,0"
                                                IsEnabled="{Binding CanRemind}"
                                                ToolTip="未入金・一部入金・期限超過の請求書で利用できます"
                                                ToolTipService.ShowOnDisabled="True"
                                                Style="{StaticResource AmberOutlineButton}"
                                                Click="RemindButton_OnClick"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBlock Text="該当する請求書がありません。">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource InnerTableEmpty}">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Invoices.Count}" Value="0">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </StackPanel>
        </Border>

        <!-- ===== ページ送り ===== -->
        <Grid Margin="0,16,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock VerticalAlignment="Center" FontSize="12" FontWeight="Medium" Foreground="{StaticResource Slate300Brush}">
                <Run Text="{Binding ResultSummary, Mode=OneWay}"/><Run Text="（1ページあたり "/><Run Text="{Binding PageSize, Mode=OneWay}"/><Run Text="件）"/>
            </TextBlock>
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button Content="← 前へ"
                        MinWidth="72"
                        IsEnabled="{Binding CanMovePrev}"
                        Style="{StaticResource AdminOutlineButton}"
                        Click="PrevPageButton_OnClick"/>
                <Button Content="次へ →"
                        Margin="8,0,0,0"
                        MinWidth="72"
                        IsEnabled="{Binding CanMoveNext}"
                        Style="{StaticResource AdminOutlineButton}"
                        Click="NextPageButton_OnClick"/>
            </StackPanel>
        </Grid>
    </StackPanel>
</UserControl>
