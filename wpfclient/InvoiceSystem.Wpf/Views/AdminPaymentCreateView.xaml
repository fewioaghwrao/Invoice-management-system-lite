<UserControl x:Class="InvoiceSystem.Wpf.Views.AdminPaymentCreateView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignWidth="1150">

    <!-- 入金登録（手動）（Next.js: app/payments/new/PaymentNewClient.tsx）。DataContext は PaymentCreateViewModel。 -->
    <StackPanel>
        <!-- ===== ページ見出し ===== -->
        <Border Style="{StaticResource PageHeaderCard}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <Button Content="ダッシュボード" Style="{StaticResource BreadcrumbButton}" Click="BreadcrumbDashboard_OnClick"/>
                        <TextBlock Text=" / " Style="{StaticResource BreadcrumbText}"/>
                        <Button Content="入金一覧" Style="{StaticResource BreadcrumbButton}" Click="BackToListButton_OnClick"/>
                        <TextBlock Text=" / 新規登録" Style="{StaticResource BreadcrumbText}"/>
                    </StackPanel>
                    <TextBlock Text="入金登録（手動）" Margin="0,6,0,0" Style="{StaticResource PageHeaderTitle}"/>
                    <TextBlock Text="入金日・金額・入金名義を入力して登録します。登録後は請求書への割当画面へ進みます。"
                               Margin="0,6,0,0"
                               Style="{StaticResource SmallMuted}"/>
                </StackPanel>
                <Button Grid.Column="1"
                        Content="← 入金一覧へ"
                        VerticalAlignment="Center"
                        Style="{StaticResource AdminOutlineButton}"
                        Click="BackToListButton_OnClick"/>
            </Grid>
        </Border>

        <!-- ===== 入力 ===== -->
        <Border Margin="0,24,0,0" Style="{StaticResource PageHeaderCard}">
            <StackPanel>
                <Border Margin="0,0,0,16"
                        Style="{StaticResource RoseBanner}"
                        Visibility="{Binding HasError, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <TextBlock Text="{Binding ErrorMessage}" Style="{StaticResource RoseBannerText}"/>
                </Border>

                <!-- 会員（入金元） -->
                <TextBlock Text="会員（入金元）" Style="{StaticResource AdminFieldLabel}"/>
                <Grid>
                    <ComboBox x:Name="MemberComboBox"
                              Style="{StaticResource AdminComboBox}"
                              ItemsSource="{Binding Members}"
                              SelectedItem="{Binding SelectedMember}"
                              DisplayMemberPath="Name"/>
                    <!-- 未選択時の案内 -->
                    <TextBlock Margin="13,0,0,0"
                               VerticalAlignment="Center"
                               FontSize="12"
                               IsHitTestVisible="False">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Text" Value="会員を選択してください"/>
                                <Setter Property="Foreground" Value="{StaticResource Slate500Brush}"/>
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsLoading}" Value="True">
                                        <Setter Property="Text" Value="会員を読み込み中..."/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding SelectedItem, ElementName=MemberComboBox}" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>
                <TextBlock Text="※ 一般 &amp; 有効の会員のみ表示（API側でフィルタ）" Style="{StaticResource AdminFieldHint}"/>

                <!-- 入金日 / 入金名義 -->
                <Grid Margin="0,16,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="入金日" Style="{StaticResource AdminFieldLabel}"/>
                        <Border Style="{StaticResource DateBox}">
                            <DatePicker Style="{StaticResource DateBoxPicker}" SelectedDate="{Binding PaymentDate}"/>
                        </Border>
                        <TextBlock Text="例：2025-03-10" Style="{StaticResource AdminFieldHint}"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <TextBlock Text="入金名義" Style="{StaticResource AdminFieldLabel}"/>
                        <TextBox Style="{StaticResource AdminTextBox}"
                                 Tag="会員を選ぶと自動入力されます（編集可）"
                                 Text="{Binding PayerName, UpdateSourceTrigger=PropertyChanged}"
                                 TextChanged="PayerNameTextBox_OnTextChanged"/>
                        <TextBlock Text="※ 会員名を初期値にします。振込名義が異なる場合は編集してください。" Style="{StaticResource AdminFieldHint}"/>
                    </StackPanel>
                </Grid>

                <!-- 入金額 -->
                <TextBlock Text="入金額（円）" Margin="0,16,0,4" Style="{StaticResource AdminFieldLabel}"/>
                <TextBox Style="{StaticResource AdminTextBox}"
                         InputScope="Number"
                         Tag="例：60000"
                         Text="{Binding AmountText, UpdateSourceTrigger=PropertyChanged}"/>
                <TextBlock Text="入金情報を手動で登録します。" Style="{StaticResource AdminFieldHint}"/>

                <!-- 入金方法 -->
                <TextBlock Text="入金方法（任意）" Margin="0,16,0,4" Style="{StaticResource AdminFieldLabel}"/>
                <ComboBox Style="{StaticResource AdminComboBox}"
                          ItemsSource="{Binding MethodOptions}"
                          SelectedItem="{Binding SelectedMethod}"
                          DisplayMemberPath="Label"/>

                <!-- 戻る / 登録して割当へ -->
                <StackPanel Margin="0,24,0,0" Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="戻る" MinWidth="64" Style="{StaticResource AdminOutlineButton}" Click="BackToListButton_OnClick"/>
                    <Button Margin="8,0,0,0" Click="SaveButton_OnClick">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource EmeraldSolidButton}">
                                <Setter Property="Content" Value="登録して割当へ"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsSaving}" Value="True">
                                        <Setter Property="Content" Value="登録中..."/>
                                        <Setter Property="IsEnabled" Value="False"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsLoading}" Value="True">
                                        <Setter Property="IsEnabled" Value="False"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </StackPanel>
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
