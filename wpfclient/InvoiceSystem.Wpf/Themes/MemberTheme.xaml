<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        会員用画面（マイページ / 請求書一覧 / 未入金の確認 / 登録情報 / 請求書詳細）の共通スタイル。
        Next.js (frontend/src/app/account/*, dashboards/member) の Tailwind 指定に合わせた配色・寸法。
        AuthTheme.xaml のブラシ・ボタンも使うため、ここでも読み込んでおく。
    -->
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/InvoiceSystem.Wpf;component/Themes/AuthTheme.xaml"/>
    </ResourceDictionary.MergedDictionaries>

    <!-- ===== 色 ===== -->
    <SolidColorBrush x:Key="Slate600Brush" Color="#475569"/>
    <SolidColorBrush x:Key="Slate500Brush" Color="#64748B"/>
    <SolidColorBrush x:Key="WhiteBrush" Color="#FFFFFF"/>
    <!-- bg-slate-900/70 -->
    <SolidColorBrush x:Key="PanelBrush" Color="#B30F172A"/>
    <!-- bg-slate-900/60 -->
    <SolidColorBrush x:Key="PanelSoftBrush" Color="#990F172A"/>
    <!-- bg-slate-950/40 -->
    <SolidColorBrush x:Key="Slate950_40Brush" Color="#66020617"/>
    <!-- bg-slate-950/30 -->
    <SolidColorBrush x:Key="Slate950_30Brush" Color="#4D020617"/>
    <!-- bg-slate-950/60 -->
    <SolidColorBrush x:Key="Slate950_60Brush" Color="#99020617"/>

    <!-- 会員画面の背景: bg-gradient-to-b from-zinc-950 via-zinc-900 to-zinc-950 -->
    <LinearGradientBrush x:Key="MemberBackgroundBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#09090B" Offset="0"/>
        <GradientStop Color="#18181B" Offset="0.5"/>
        <GradientStop Color="#09090B" Offset="1"/>
    </LinearGradientBrush>

    <!-- アイコン用フォント（Windows 11: Segoe Fluent Icons / Windows 10: Segoe MDL2 Assets） -->
    <FontFamily x:Key="IconFont">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>

    <!-- ===== 文字 ===== -->
    <Style x:Key="SectionTitle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="16"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{StaticResource Slate50Brush}"/>
    </Style>
    <Style x:Key="SmallMuted" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Foreground" Value="{StaticResource Slate400Brush}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>
    <Style x:Key="TinyMuted" TargetType="TextBlock">
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="Foreground" Value="{StaticResource Slate500Brush}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>
    <Style x:Key="IconGlyph" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource IconFont}"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="TextAlignment" Value="Center"/>
    </Style>

    <!-- ===== パネル: rounded-2xl border-slate-800 bg-slate-900/70 ===== -->
    <Style x:Key="Panel" TargetType="Border">
        <Setter Property="CornerRadius" Value="16"/>
        <Setter Property="BorderBrush" Value="{StaticResource Slate800Brush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Background" Value="{StaticResource PanelBrush}"/>
    </Style>

    <!-- 期限超過バナー（請求書一覧）: border-amber-900/40 bg-amber-950/40 text-amber-100 -->
    <Style x:Key="AmberBanner" TargetType="Border">
        <Setter Property="CornerRadius" Value="16"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="BorderBrush" Value="#6678350F"/>
        <Setter Property="Background" Value="#66451A03"/>
        <Setter Property="Padding" Value="16"/>
    </Style>

    <!-- 期限超過バナー（未入金の確認）: border-amber-500/30 bg-amber-500/10 text-amber-200 -->
    <Style x:Key="AmberBannerBright" TargetType="Border" BasedOn="{StaticResource AmberBanner}">
        <Setter Property="BorderBrush" Value="#4DF59E0B"/>
        <Setter Property="Background" Value="#1AF59E0B"/>
    </Style>

    <!-- エラー: border-rose-500/30 bg-rose-500/10 text-rose-200 -->
    <Style x:Key="RoseBanner" TargetType="Border">
        <Setter Property="CornerRadius" Value="12"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="BorderBrush" Value="#4DF43F5E"/>
        <Setter Property="Background" Value="#1AF43F5E"/>
        <Setter Property="Padding" Value="12"/>
    </Style>
    <Style x:Key="RoseBannerText" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Foreground" Value="#FECDD3"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>

    <!-- 「⚠ 期限超過」ラベル: rounded-full bg-amber-500/10 text-amber-200 ring-amber-900/40 -->
    <Style x:Key="OverdueBadge" TargetType="Border">
        <Setter Property="HorizontalAlignment" Value="Left"/>
        <Setter Property="CornerRadius" Value="999"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="BorderBrush" Value="#6678350F"/>
        <Setter Property="Background" Value="#1AF59E0B"/>
        <Setter Property="Padding" Value="8,2"/>
        <Setter Property="Margin" Value="0,4,0,0"/>
    </Style>
    <Style x:Key="OverdueBadgeText" TargetType="TextBlock">
        <Setter Property="Text" Value="⚠ 期限超過"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="#FDE68A"/>
    </Style>

    <!-- ===== 表 ===== -->
    <!-- 見出し行: bg-slate-950/40 text-slate-300 font-semibold -->
    <Style x:Key="TableHeaderRow" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource Slate950_40Brush}"/>
        <Setter Property="Padding" Value="4,0"/>
        <Setter Property="MinHeight" Value="44"/>
    </Style>
    <Style x:Key="TableHeaderText" TargetType="TextBlock">
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{StaticResource Slate300Brush}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Margin" Value="12,0"/>
    </Style>
    <!-- データ行: divide-y divide-slate-800 / hover:bg-slate-950/30 -->
    <Style x:Key="TableRow" TargetType="Border">
        <Setter Property="BorderBrush" Value="{StaticResource Slate800Brush}"/>
        <Setter Property="BorderThickness" Value="0,1,0,0"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Padding" Value="4,12"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource Slate950_30Brush}"/>
            </Trigger>
        </Style.Triggers>
    </Style>
    <Style x:Key="TableCellText" TargetType="TextBlock">
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="Foreground" Value="{StaticResource Slate200Brush}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Margin" Value="12,0"/>
    </Style>
    <Style x:Key="TableCellStrong" TargetType="TextBlock" BasedOn="{StaticResource TableCellText}">
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{StaticResource Slate100Brush}"/>
    </Style>
    <Style x:Key="TableEmptyText" TargetType="TextBlock">
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="Foreground" Value="{StaticResource Slate400Brush}"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
        <Setter Property="Margin" Value="0,40"/>
    </Style>

    <!-- ===== ボタン ===== -->

    <!-- 左メニュー項目: rounded-xl border px-3 py-2.5 text-sm font-medium
         通常: border-transparent text-slate-300 / hover: border-slate-700 bg-slate-800/80 text-white
         選択中: border-sky-500/50 bg-slate-700/70 text-white -->
    <Style x:Key="NavItem" TargetType="RadioButton">
        <Setter Property="MinHeight" Value="44"/>
        <Setter Property="Margin" Value="0,0,0,6"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="FontWeight" Value="Medium"/>
        <Setter Property="Foreground" Value="{StaticResource Slate300Brush}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource RoundedFocusVisual}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="Bd"
                            CornerRadius="12"
                            BorderThickness="1"
                            BorderBrush="Transparent"
                            Background="Transparent"
                            Padding="12,0">
                        <ContentPresenter VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Slate700Brush}"/>
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource GhostHoverBrush}"/>
                            <Setter Property="Foreground" Value="{StaticResource WhiteBrush}"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="#800EA5E9"/>
                            <Setter TargetName="Bd" Property="Background" Value="#B3334155"/>
                            <Setter Property="Foreground" Value="{StaticResource WhiteBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ログアウト: text-red-400 border-red-500/40 rounded-md hover:bg-red-500/10 hover:text-red-300 -->
    <Style x:Key="LogoutButton" TargetType="Button">
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="Foreground" Value="{StaticResource Red400Brush}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource RoundedFocusVisual}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd"
                            CornerRadius="6"
                            BorderThickness="1"
                            BorderBrush="#66EF4444"
                            Background="Transparent"
                            Padding="12,4">
                        <ContentPresenter VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#1AEF4444"/>
                            <Setter Property="Foreground" Value="#FCA5A5"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- マイページのメニューカード: rounded-2xl border-slate-800 bg-slate-900/60 p-5
         hover: 少し浮く + bg-slate-900/80 + 枠線をアクセント色（Tag で指定） -->
    <Style x:Key="MenuCardButton" TargetType="Button">
        <Setter Property="MinHeight" Value="144"/>
        <Setter Property="Padding" Value="20"/>
        <Setter Property="Background" Value="{StaticResource PanelSoftBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource Slate800Brush}"/>
        <Setter Property="Foreground" Value="{StaticResource Slate100Brush}"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="VerticalContentAlignment" Value="Stretch"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource RoundedFocusVisual}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid x:Name="Root">
                        <Border x:Name="Shadow"
                                CornerRadius="16"
                                Background="#0F172A"
                                Opacity="0">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="24" ShadowDepth="8" Direction="270" Opacity="0.45" Color="#000000"/>
                            </Border.Effect>
                        </Border>
                        <Border x:Name="Bd"
                                CornerRadius="16"
                                BorderThickness="1"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Root" Property="RenderTransform">
                                <Setter.Value>
                                    <TranslateTransform Y="-2"/>
                                </Setter.Value>
                            </Setter>
                            <Setter TargetName="Shadow" Property="Opacity" Value="1"/>
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource CardBrush}"/>
                            <Setter TargetName="Bd" Property="BorderBrush"
                                    Value="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 「開く →」: rounded-full border-slate-700 bg-slate-950/40 px-3 py-1.5 text-xs text-slate-300 -->
    <Style x:Key="OpenPill" TargetType="Border">
        <Setter Property="HorizontalAlignment" Value="Right"/>
        <Setter Property="VerticalAlignment" Value="Bottom"/>
        <Setter Property="CornerRadius" Value="999"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="BorderBrush" Value="{StaticResource Slate700Brush}"/>
        <Setter Property="Background" Value="{StaticResource Slate950_40Brush}"/>
        <Setter Property="Padding" Value="12,6"/>
    </Style>

    <!-- 検索: rounded-xl bg-blue-600 px-5 text-sm font-semibold text-white hover:bg-blue-700 -->
    <Style x:Key="BlueButton" TargetType="Button">
        <Setter Property="Height" Value="44"/>
        <Setter Property="MinWidth" Value="68"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{StaticResource WhiteBrush}"/>
        <Setter Property="Background" Value="#2563EB"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource RoundedFocusVisual}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" CornerRadius="12" Background="{TemplateBinding Background}" Padding="20,0">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#1D4ED8"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Bd" Property="Opacity" Value="0.6"/>
                            <Setter Property="Cursor" Value="Arrow"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 文字だけのボタン（条件クリア / 請求書一覧へ → など）: text-slate-300 hover:text-white -->
    <Style x:Key="PlainLinkButton" TargetType="Button" BasedOn="{StaticResource LinkButton}">
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="Foreground" Value="{StaticResource Slate300Brush}"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Foreground" Value="{StaticResource WhiteBrush}"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.5"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- 表内の「詳細」: font-semibold text-sky-300 hover:text-sky-200 -->
    <Style x:Key="DetailLinkButton" TargetType="Button" BasedOn="{StaticResource LinkButton}">
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Foreground" Value="#BAE6FD"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- 前へ / 次へ: rounded-xl border px-4
         有効: border-slate-700 text-slate-200 hover:bg-slate-950/30 / 無効: border-slate-800 text-slate-500 -->
    <Style x:Key="PagerButton" TargetType="Button">
        <Setter Property="Height" Value="44"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="Foreground" Value="{StaticResource Slate200Brush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource Slate700Brush}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource RoundedFocusVisual}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd"
                            CornerRadius="12"
                            BorderThickness="1"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            Background="Transparent"
                            Padding="16,0">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource Slate950_30Brush}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Slate800Brush}"/>
                            <Setter Property="Foreground" Value="{StaticResource Slate500Brush}"/>
                            <Setter Property="Cursor" Value="Arrow"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 小さめの枠付きボタン（PDF表示）: rounded-lg border-slate-700 bg-slate-950/30 px-3 py-2 text-xs font-semibold text-slate-200 -->
    <Style x:Key="SmallOutlineButton" TargetType="Button">
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{StaticResource Slate200Brush}"/>
        <Setter Property="Background" Value="{StaticResource Slate950_30Brush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource Slate700Brush}"/>
        <Setter Property="Padding" Value="12,8"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource RoundedFocusVisual}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd"
                            CornerRadius="8"
                            BorderThickness="1"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            Background="{TemplateBinding Background}"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Foreground" Value="{StaticResource WhiteBrush}"/>
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Slate600Brush}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Bd" Property="Opacity" Value="0.5"/>
                            <Setter Property="Cursor" Value="Arrow"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 保存: rounded-lg bg-emerald-600 px-4 py-2 text-xs text-white hover:bg-emerald-500 -->
    <Style x:Key="EmeraldButton" TargetType="Button" BasedOn="{StaticResource SmallOutlineButton}">
        <Setter Property="FontWeight" Value="Normal"/>
        <Setter Property="Foreground" Value="{StaticResource WhiteBrush}"/>
        <Setter Property="Background" Value="#059669"/>
        <Setter Property="BorderBrush" Value="#059669"/>
        <Setter Property="Padding" Value="16,8"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="#10B981"/>
                <Setter Property="BorderBrush" Value="#10B981"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- 退会する: rounded-lg border-rose-500/40 bg-rose-500/10 px-4 py-2 text-xs text-rose-200 -->
    <Style x:Key="RoseSoftButton" TargetType="Button" BasedOn="{StaticResource SmallOutlineButton}">
        <Setter Property="FontWeight" Value="Normal"/>
        <Setter Property="Foreground" Value="#FECDD3"/>
        <Setter Property="Background" Value="#1AF43F5E"/>
        <Setter Property="BorderBrush" Value="#66F43F5E"/>
        <Setter Property="Padding" Value="16,8"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="#26F43F5E"/>
                <Setter Property="Foreground" Value="#FECDD3"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- ===== 入力 ===== -->

    <!-- 検索欄: rounded-xl border-slate-700 bg-slate-950/40 min-h-11 text-sm -->
    <Style x:Key="FilterTextBox" TargetType="TextBox" BasedOn="{StaticResource ModernTextBox}">
        <Setter Property="Height" Value="44"/>
        <Setter Property="Background" Value="{StaticResource Slate950_40Brush}"/>
        <Setter Property="Foreground" Value="{StaticResource Slate100Brush}"/>
    </Style>

    <!-- 登録情報の入力欄: rounded-lg border-slate-700 bg-slate-950/60 px-3 py-2 text-xs focus:border-emerald-500 -->
    <Style x:Key="CompactTextBox" TargetType="TextBox">
        <Setter Property="Height" Value="34"/>
        <Setter Property="Padding" Value="12,0"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Foreground" Value="{StaticResource Slate100Brush}"/>
        <Setter Property="CaretBrush" Value="{StaticResource Slate100Brush}"/>
        <Setter Property="SelectionBrush" Value="#10B981"/>
        <Setter Property="Background" Value="{StaticResource Slate950_60Brush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource Slate700Brush}"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="Bd"
                            CornerRadius="8"
                            BorderThickness="1"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}">
                        <ScrollViewer x:Name="PART_ContentHost"
                                      Margin="{TemplateBinding Padding}"
                                      VerticalAlignment="Center"
                                      Focusable="False"
                                      HorizontalScrollBarVisibility="Hidden"
                                      VerticalScrollBarVisibility="Hidden"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="#10B981"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.6"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="CompactLabel" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Foreground" Value="{StaticResource Slate300Brush}"/>
        <Setter Property="Margin" Value="0,0,0,4"/>
    </Style>

    <!-- 絞り込み用の選択欄: rounded-xl border-slate-700 bg-slate-950/40 min-h-11 text-sm -->
    <Style x:Key="FilterComboBoxItem" TargetType="ComboBoxItem">
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="Foreground" Value="{StaticResource Slate100Brush}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBoxItem">
                    <Border x:Name="Bd" CornerRadius="8" Background="Transparent" Padding="10,8">
                        <ContentPresenter/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource Slate800Brush}"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#330EA5E9"/>
                            <Setter Property="Foreground" Value="{StaticResource WhiteBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="FilterComboBox" TargetType="ComboBox">
        <Setter Property="Height" Value="44"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="Foreground" Value="{StaticResource Slate100Brush}"/>
        <Setter Property="Background" Value="{StaticResource Slate950_40Brush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource Slate700Brush}"/>
        <Setter Property="MaxDropDownHeight" Value="320"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="ItemContainerStyle" Value="{StaticResource FilterComboBoxItem}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <Grid>
                        <Border x:Name="Ring"
                                Margin="-2"
                                CornerRadius="14"
                                BorderThickness="2"
                                BorderBrush="{StaticResource FocusRingBrush}"
                                Opacity="0"/>
                        <Border x:Name="Bd"
                                CornerRadius="12"
                                BorderThickness="1"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"/>

                        <ContentPresenter x:Name="ContentSite"
                                          Margin="12,0,36,0"
                                          HorizontalAlignment="Left"
                                          VerticalAlignment="Center"
                                          IsHitTestVisible="False"
                                          Content="{TemplateBinding SelectionBoxItem}"
                                          ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                          ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                          ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}"/>

                        <Path HorizontalAlignment="Right"
                              VerticalAlignment="Center"
                              Margin="0,0,16,0"
                              Data="M0,0 L5,5 L10,0"
                              Stroke="{StaticResource Slate400Brush}"
                              StrokeThickness="1.5"
                              IsHitTestVisible="False"/>

                        <!-- クリック領域（見た目は上の Border が担当） -->
                        <ToggleButton Focusable="False"
                                      ClickMode="Press"
                                      IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="ToggleButton">
                                    <Border Background="Transparent"/>
                                </ControlTemplate>
                            </ToggleButton.Template>
                        </ToggleButton>

                        <Popup x:Name="PART_Popup"
                               Placement="Bottom"
                               VerticalOffset="4"
                               AllowsTransparency="True"
                               Focusable="False"
                               PopupAnimation="Fade"
                               IsOpen="{TemplateBinding IsDropDownOpen}">
                            <Border MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                                    MaxHeight="{TemplateBinding MaxDropDownHeight}"
                                    CornerRadius="12"
                                    BorderThickness="1"
                                    BorderBrush="{StaticResource Slate700Brush}"
                                    Background="#0F172A"
                                    Padding="4">
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained"/>
                                </ScrollViewer>
                            </Border>
                        </Popup>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Slate600Brush}"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Sky500Brush}"/>
                            <Setter TargetName="Ring" Property="Opacity" Value="1"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.6"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="FilterLabel" TargetType="TextBlock">
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="Foreground" Value="{StaticResource Slate300Brush}"/>
        <Setter Property="Margin" Value="0,0,0,4"/>
    </Style>
</ResourceDictionary>
